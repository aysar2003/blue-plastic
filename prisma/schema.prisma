// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  /// Argon2id/bcrypt hash. Null for users who only ever sign in via an OAuth
  /// provider (none configured yet — see ADR-0007).
  passwordHash  String?
  image         String?
  emailVerified DateTime? @db.Timestamptz(6)
  /// Optional mobile (E.164). Login alias + future WhatsApp/SMS notify.
  phone         String?   @unique

  /// Authenticator app (TOTP). Secret sealed with AUTH_SECRET; null when off.
  totpSecretSealed String?
  totpEnabledAt    DateTime? @db.Timestamptz(6)
  /// Email one-time codes as a second factor at sign-in.
  otp2faEnabledAt  DateTime? @db.Timestamptz(6)

  lastLoginAt DateTime? @db.Timestamptz(6)

  /// Owns this installation. Sees every company database and the consolidated
  /// reports. Everyone else is sent to `homeOrgId` and does not see the others.
  isSystemOwner Boolean @default(false)

  /// Company opened at sign-in. Set when the person is first added, and kept
  /// so a later invite into another company does not move them.
  homeOrgId String?

  /// Home dashboard KPI pin order. Shape: `{ kpiPins?: ('profitMtd'|'openAr'|'reorder')[] }`.
  dashboardPrefs Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  accounts    Account[]
  sessions    Session[]
  auditLogs   AuditLog[]
  bookmarks   WorkspaceBookmark[]
  todosOwned      WorkspaceTodo[] @relation("WorkspaceTodoOwner")
  todosAssigned   WorkspaceTodo[] @relation("WorkspaceTodoAssignee")
  todosCompleted  WorkspaceTodo[] @relation("WorkspaceTodoCompletedBy")
  documentsUploaded WorkspaceDocument[] @relation("WorkspaceDocumentCreatedBy")
  knowledgeCreated   KnowledgeArticle[]  @relation("KnowledgeCreatedBy")
  knowledgeUpdated   KnowledgeArticle[]  @relation("KnowledgeUpdatedBy")
  knowledgeOwned     KnowledgeArticle[]  @relation("KnowledgeOwner")
  knowledgeLocked    KnowledgeArticle[]  @relation("KnowledgeLockedBy")
  knowledgeFavorites KnowledgeFavorite[]
  knowledgeShares    KnowledgeShare[]
  knowledgeRevisions KnowledgeRevision[] @relation("KnowledgeRevisionAuthor")
  employees          Employee[]
  leaveRequestsDecided LeaveRequest[] @relation("LeaveRequestDecidedBy")
  leaveRequestsCreated LeaveRequest[] @relation("LeaveRequestCreatedBy")
  payrollRunsCreated   PayrollRun[]   @relation("PayrollRunCreatedBy")
  endOfServiceCreated  EndOfService[] @relation("EndOfServiceCreatedBy")
  employeeContractsCreated EmployeeContract[] @relation("EmployeeContractCreatedBy")
  employeeDocumentsCreated EmployeeDocument[] @relation("EmployeeDocumentCreatedBy")
  hrPoliciesCreated        HrPolicy[]         @relation("HrPolicyCreatedBy")
  calendarEvents CalendarEvent[]
  posRegisters PosRegisterStaff[]
  customerPortalUsers CustomerPortalUser[]
  approvalRequestsSubmitted ApprovalRequest[]  @relation("ApprovalSubmittedBy")
  approvalDecisions         ApprovalDecision[] @relation("ApprovalDecidedBy")
  approvalPoliciesAssigned  ApprovalPolicyApprover[]
  projectsCreated           Project[]          @relation("ProjectCreatedBy")
  projectTasksCreated       ProjectTask[]      @relation("ProjectTaskCreatedBy")
  projectTasksAssigned      ProjectTask[]      @relation("ProjectTaskAssignee")
  projectTimeEntries        ProjectTimeEntry[] @relation("ProjectTimeEntryUser")
  appAccessRequests         AppAccessRequest[] @relation("AppAccessRequestedBy")
  appAccessReviews          AppAccessRequest[] @relation("AppAccessReviewedBy")
  recurringTemplatesCreated RecurringTemplate[] @relation("RecurringCreatedBy")
  authChallenges            AuthChallenge[]
  loginTickets              LoginTicket[]
  discussMessagesAuthored   DiscussMessage[] @relation("DiscussMessageAuthor")
  crmActivitiesCreated      CrmActivity[]    @relation("CrmActivityCreatedBy")
  apiKeysCreated            ApiKey[]         @relation("ApiKeyCreatedBy")

  @@map("users")
}

/// Organisation machine credential for /api/v1 and MCP (Phase 22).
/// Plain token is shown once; only lookup hash + bcrypt hash are stored.
model ApiKey {
  id    String @id @default(cuid())
  orgId String

  name   String
  /// Display prefix (e.g. som_ab12…).
  prefix String
  /// sha256 hex of the full token — unique lookup index.
  tokenLookup String @unique
  /// bcrypt of the full token.
  tokenHash String
  /// Permission scopes granted to this key (subset of staff permissions).
  scopes String[]

  createdById String
  lastUsedAt  DateTime? @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([orgId, revokedAt])
  @@index([orgId, name])
  @@map("api_keys")
}

model Membership {
  id     String @id @default(cuid())
  orgId  String
  userId String

  role   Role             @default(VIEWER)
  status MembershipStatus @default(INVITED)

  /// When non-empty, this list is the member’s exact capability set (role is then
  /// a label / starting template). Empty means use ROLE_PERMISSIONS[role].
  /// Required in practice when role is CUSTOM.
  permissionsOverride String[] @default([])

  /// Switch company databases (Connect). Only an admin may hold this, and only
  /// the system owner may turn it on. Staff never receive it.
  canConnect Boolean @default(false)

  /// Incremented on every role or status change. The JWT carries the value it was
  /// issued with; a mismatch invalidates the session on the next request, which
  /// gives JWT sessions revocation semantics (ADR-0007).
  version Int @default(1)

  invitedById String?
  invitedAt   DateTime? @db.Timestamptz(6)
  acceptedAt  DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, status])
  @@map("memberships")
}

/// Outside people asking to join SOM ERP. Stored until the system owner
/// approves (creates company + owner) or rejects. No User row until APPROVED.
model CompanySignupRequest {
  id String @id @default(cuid())

  organizationName     String
  baseCurrency         String   @db.Char(3)
  fiscalYearStartMonth Int      @default(1)
  ownerName            String
  email                String
  /// Password hash ready to copy onto User on approve — never plaintext.
  passwordHash         String

  /// Apps the applicant asked for. Shape: `Record<ModuleFlag, boolean>` from
  /// `lib/feature-flags.ts`. Null = all apps (legacy requests).
  requestedModules Json?

  status     CompanySignupStatus @default(PENDING)
  reviewedAt DateTime?           @db.Timestamptz(6)
  reviewedBy String?
  note       String?

  /// Set when approved — the company that was created.
  organizationId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([email, status])
  @@map("company_signup_requests")
}

// --- NextAuth adapter tables ------------------------------------------------
// Present from the start so adding an OAuth provider later is configuration
// rather than a migration against a live database.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Short-lived hashed OTP / setup codes for optional 2FA (not Auth.js email tokens).
model AuthChallenge {
  id         String    @id @default(cuid())
  userId     String
  /// LOGIN_OTP | ENABLE_OTP | ENABLE_TOTP
  purpose    String
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("auth_challenges")
}

/// One-time login tickets (post-password / post-2FA). Replay is rejected after consume.
model LoginTicket {
  /// Random id embedded in the sealed ticket payload.
  jti        String    @id
  userId     String
  audience   String
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("login_tickets")
}

/// Shared sliding-window counters (works across serverless replicas).
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @db.Timestamptz(6)

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Cross-cutting infrastructure
// ---------------------------------------------------------------------------

model AuditLog {
  id      String @id @default(cuid())
  orgId   String
  actorId String?

  entity   String
  entityId String
  action   AuditAction

  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  at DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  trashFiles   TrashFile[]

  @@index([orgId, at(sort: Desc)])
  @@index([orgId, entity, entityId])
  @@index([orgId, actorId, at(sort: Desc)])
  @@map("audit_logs")
}

/// A paper kept against a trash (deletion) log line — the form PDF, a scan, or a note.
model TrashFile {
  id         String @id @default(cuid())
  orgId      String
  auditLogId String

  originalName String
  contentType  String
  byteSize     Int
  /// Path under uploads/trash. Never a public URL.
  storageKey   String

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdById String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auditLog     AuditLog     @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  @@index([orgId, auditLogId])
  @@map("trash_files")
}

model DocumentSequence {
  id    String @id @default(cuid())
  orgId String

  docType    DocumentType
  prefix     String       @default("")
  nextNumber Int          @default(1)
  padding    Int          @default(5) @db.SmallInt

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, docType])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// The ledger  (Phase 2)
// ---------------------------------------------------------------------------

/// Chart of accounts.
///
/// Named `LedgerAccount` rather than `Account` because NextAuth's adapter already
/// owns that table name, and renaming the adapter's table to free it up would
/// break a convention for no gain.
model LedgerAccount {
  id    String @id @default(cuid())
  orgId String

  /// Account number. Unique per organisation; sorts the chart.
  code        String
  name        String
  description String?

  type    AccountType
  subtype AccountSubtype

  /// Report grouping only. A parent never carries postings of its own.
  parentId String?

  /// Set for the handful of accounts the engine refers to by name.
  systemKey SystemAccountKey?

  /// System accounts cannot be deleted or repurposed. Ordinary accounts can be
  /// archived but never deleted once they carry a posted line.
  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  /// Set on BANK and CREDIT_CARD accounts held in a currency other than the
  /// organisation's base. Unused until multi-currency lands (ADR-0006).
  currencyCode String? @db.Char(3)

  /// A finer label under the subtype, such as "Sales of product income".
  /// The subtype still decides how the books behave; this only names the account
  /// more precisely on the chart and on reports.
  detailType String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       LedgerAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     LedgerAccount[] @relation("AccountHierarchy")
  journalLines JournalLine[]

  // Master data that points at this account (Phase 3). All Restrict: an account
  // an item or a tax rate posts through cannot quietly disappear.
  vendorDefaults    Vendor[]  @relation("VendorDefaultExpense")
  itemsIncome       Item[]    @relation("ItemIncome")
  itemsExpense      Item[]    @relation("ItemExpense")
  itemsInventory    Item[]    @relation("ItemInventory")
  itemsCogs         Item[]    @relation("ItemCogs")
  itemsDeposit      Item[]    @relation("ItemDeposit")
  taxRatesSales     TaxRate[] @relation("TaxRateSales")
  taxRatesPurchase  TaxRate[] @relation("TaxRatePurchase")
  salesLines        SalesDocumentLine[]    @relation("SalesLineIncome")
  salesDeposits     SalesDocument[]        @relation("SalesDepositAccount")
  paymentDeposits   CustomerPayment[]      @relation("PaymentDepositAccount")
  purchaseLines     PurchaseDocumentLine[] @relation("PurchaseLineExpense")
  purchasePayments  PurchaseDocument[]     @relation("PurchasePaymentAccount")
  billPaymentSource BillPayment[]          @relation("BillPaymentAccount")
  adjustments       InventoryAdjustment[]  @relation("AdjustmentAccount")
  stores            Store[]                @relation("StoreAccount")
  transfersFrom     BankTransfer[]         @relation("TransferFrom")
  transfersTo       BankTransfer[]         @relation("TransferTo")
  deposits          Deposit[]              @relation("DepositBankAccount")
  depositLines      DepositLine[]          @relation("DepositLineAccount")
  importedLines     ImportedTransaction[]
  importCategories  ImportedTransaction[] @relation("ImportCategory")
  reconciliations   BankReconciliation[]
  rulesForBank      BankRule[]            @relation("RuleBank")
  rulesForCategory  BankRule[]            @relation("RuleCategory")
  posPaymentMethods PosPaymentMethod[]    @relation("PosPaymentAccount")
  posRegisters      PosRegister[]         @relation("PosRegisterBank")
  posChangeOrders   PosOrder[]            @relation("PosChangeAccount")
  posOrderDeposits  PosOrder[]            @relation("PosOrderDeposit")
  posCashMoveCounterparties PosCashMovement[] @relation("PosCashMoveCounterparty")
  budgetLines               BudgetLine[]
  employeeWageExpense       Employee[]    @relation("EmployeeWageExpense")
  employeeWagePayable       Employee[]    @relation("EmployeeWagePayable")
  employeePayAccount        Employee[]    @relation("EmployeePayAccount")
  payrollRunPayFrom         PayrollRun[]  @relation("PayrollRunPayFrom")
  payrollRunLiability       PayrollRun[]  @relation("PayrollRunLiability")
  salaryRuleExpense         SalaryRule[]  @relation("SalaryRuleExpense")
  salaryRuleLiability       SalaryRule[]  @relation("SalaryRuleLiability")
  advanceAccounts           EmployeeAdvance[] @relation("AdvanceAccount")
  endOfServiceExpense       EndOfService[] @relation("EndOfServiceExpense")
  endOfServicePay           EndOfService[] @relation("EndOfServicePay")
  fixedAssetCostAccounts    FixedAssetCategory[] @relation("FixedAssetCostAccount")
  fixedAssetAccumAccounts   FixedAssetCategory[] @relation("FixedAssetAccumAccount")
  fixedAssetExpenseAccounts FixedAssetCategory[] @relation("FixedAssetExpenseAccount")
  shareholderCapitalAccounts Shareholder[] @relation("ShareholderCapitalAccount")
  equityEventBanks          EquityEvent[] @relation("EquityEventBank")
  equityEventEquityAccounts EquityEvent[] @relation("EquityEventEquity")

  @@unique([orgId, code])
  @@unique([orgId, systemKey])
  /// Target for the composite foreign key on journal_lines that makes a
  /// cross-organisation line structurally impossible (R9).
  @@unique([id, orgId])
  @@index([orgId, type, code])
  @@index([orgId, parentId])
  @@index([orgId, isActive])
  @@map("ledger_accounts")
}

model FiscalYear {
  id    String @id @default(cuid())
  orgId String

  /// The calendar year the fiscal year *begins* in. A year starting in April 2026
  /// and ending in March 2027 is fiscal year 2026.
  year      Int
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    PeriodStatus @default(OPEN)

  closedAt         DateTime? @db.Timestamptz(6)
  closingJournalId String?   @unique

  /// When set, transactional detail for this year lives in object storage and was
  /// removed from the hot ledger. Restore reloads the package. Live window keeps
  /// the newest 5 fiscal years; older locked years may be archived one at a time.
  archivedAt         DateTime? @db.Timestamptz(6)
  archiveChecksum    String?
  /// Cold package id in `year_archive_blobs` (not joined by day-to-day posting).
  archiveBlobId      String?   @unique
  /// Journal that replaces archived year BS movements so the live ledger still
  /// balances after purge. Cleared on restore.
  archiveBridgeJournalId String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  periods      AccountingPeriod[]
  archiveBlob  YearArchiveBlob?   @relation(fields: [archiveBlobId], references: [id], onDelete: SetNull)

  @@unique([orgId, year])
  @@index([orgId, startDate])
  @@index([orgId, archivedAt])
  @@map("fiscal_years")
}

/// Gzip JSON package for one archived fiscal year. Kept out of the hot journal path.
model YearArchiveBlob {
  id        String   @id @default(cuid())
  orgId     String
  year      Int
  checksum  String
  /// gzip(JSON year package)
  payload   Bytes
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear?

  @@index([orgId, year])
  @@map("year_archive_blobs")
}

/// Twelve monthly periods per fiscal year, plus period 0 — a zero-length period
/// dated the day before the year begins, which is where opening balances land so
/// they never fall inside a reportable trading month.
model AccountingPeriod {
  id           String @id @default(cuid())
  orgId        String
  fiscalYearId String

  periodNumber Int          @db.SmallInt
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  status       PeriodStatus @default(OPEN)

  closedAt   DateTime? @db.Timestamptz(6)
  closedById String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journals     Journal[]

  @@unique([fiscalYearId, periodNumber])
  /// Every posting resolves its period by date, so this is the hottest index on
  /// the write path.
  @@index([orgId, startDate, endDate])
  @@map("accounting_periods")
}

/// A balanced set of entries. Immutable once posted (R4) — corrections are
/// reversals, enforced by trigger rather than by convention.
model Journal {
  id    String @id @default(cuid())
  orgId String

  journalNumber String
  /// Calendar date, not an instant: a 31 January entry belongs to January for
  /// every reader in every timezone.
  date          DateTime @db.Date
  periodId      String

  memo String?

  sourceType JournalSourceType
  /// The document that produced this journal, if any. Null for manual entries.
  sourceId   String?

  status         JournalStatus @default(POSTED)
  isAdjusting    Boolean       @default(false)
  isClosingEntry Boolean       @default(false)

  /// When set on a posted manual accrual, a mirror journal is written dated the
  /// first day of the next accounting period (Phase 11.8). The flag stays on the
  /// original for display; the reversal is the ordinary `reversedBy` row.
  autoReverse Boolean @default(false)

  /// Set on a reversing journal, pointing at what it reverses. Unique, because a
  /// journal may be reversed exactly once — the back-relation `reversedBy` reads
  /// it from the other side.
  reversalOfId   String? @unique
  reversalReason String?

  /// Always the organisation's base currency and 1 until multi-currency lands.
  /// Written from the start so no backfill is ever needed (ADR-0006).
  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  /// Prevents a retried request from posting the same journal twice.
  idempotencyKey String?

  postedAt    DateTime @default(now()) @db.Timestamptz(6)
  createdById String?

  /// When this entry was deleted, and by whom. Set together with status DELETED
  /// and never unset — see `server/accounting/deletion.ts`.
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?
  deleteReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period       AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines        JournalLine[]
  salesDocuments    SalesDocument[]
  customerPayments  CustomerPayment[]
  purchaseDocuments PurchaseDocument[]
  billPayments      BillPayment[]
  bankTransfers     BankTransfer[]
  deposits          Deposit[]
  inventoryMovements InventoryTransaction[]
  inventoryAdjustments InventoryAdjustment[]
  assemblyBuilds       AssemblyBuild[]
  storeTransfers StoreTransfer[]
  files LedgerFile[]
  posCashMovements PosCashMovement[]
  posSessionCloses PosSession[] @relation("PosSessionCloseJournal")
  posOrderTips     PosOrder[]   @relation("PosOrderTipJournal")
  payrollRun            PayrollRun? @relation("PayrollRunAccrual")
  payrollRunSettlement  PayrollRun? @relation("PayrollRunSettlement")
  endOfService          EndOfService?
  fixedAssetDepreciations FixedAssetDepreciation[]
  equityEvents            EquityEvent[]

  reversalOf Journal? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy Journal? @relation("JournalReversal")

  icMatchAsA IntercompanyMatch? @relation("IcMatchJournalA")
  icMatchAsB IntercompanyMatch? @relation("IcMatchJournalB")

  @@unique([orgId, journalNumber])
  @@index([orgId, deletedAt])
  @@unique([orgId, idempotencyKey])
  /// Target for the composite foreign key on journal_lines (R9).
  @@unique([id, orgId])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, sourceType, sourceId])
  @@index([orgId, status])
  @@index([periodId])
  @@map("journals")
}

/// Phase 35: confirmed pair of intercompany journals across two orgs in a group.
model IntercompanyMatch {
  id         String @id @default(cuid())
  /// Group root (main company) that owns this match for listing / close checklist.
  rootOrgId  String
  journalAId String @unique
  journalBId String @unique
  /// Absolute amount matched (base of journal A), informational.
  amount     Decimal @db.Decimal(19, 4)
  matchedAt  DateTime @default(now()) @db.Timestamptz(6)
  matchedById String?
  notes      String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  root     Organization @relation("IcMatchRoot", fields: [rootOrgId], references: [id], onDelete: Cascade)
  journalA Journal      @relation("IcMatchJournalA", fields: [journalAId], references: [id], onDelete: Cascade)
  journalB Journal      @relation("IcMatchJournalB", fields: [journalBId], references: [id], onDelete: Cascade)

  @@index([rootOrgId, matchedAt(sort: Desc)])
  @@map("intercompany_matches")
}

/// One side of one entry. A line is a debit or a credit, never both (R1).
model JournalLine {
  id        String @id @default(cuid())
  journalId String
  orgId     String

  lineNumber Int @db.SmallInt

  accountId String

  debit  Decimal @default(0) @db.Decimal(19, 4)
  credit Decimal @default(0) @db.Decimal(19, 4)

  description String?

  /// Denormalised from the journal, set authoritatively by a trigger. Redundant
  /// and worth it: every ledger and report query filters lines by date, and
  /// without it each one pays a join to the header.
  journalDate DateTime @db.Date

  /// Subledger dimensions. A line hitting the AR or AP control account must carry
  /// its counterparty (R7) — that is what makes the aging report and the control
  /// account balance two queries over the same rows rather than two numbers that
  /// have to be reconciled.
  ///
  /// The columns existed from Phase 2 so the rule could be enforced from the
  /// ledger's first row; Phase 3 added the tables and the foreign keys.
  customerId String?
  vendorId   String?

  /// Optional class (QuickBooks language). One tracking dimension so a profit
  /// and loss can split income and expense by shop, site, or department.
  trackingCategoryId String?

  /// Foreign-currency amounts, unused until multi-currency lands (ADR-0006).
  foreignDebit  Decimal? @db.Decimal(19, 4)
  foreignCredit Decimal? @db.Decimal(19, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  journal  Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account  LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendor   Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  trackingCategory TrackingCategory? @relation(fields: [trackingCategoryId], references: [id], onDelete: Restrict)

  /// Whether this line has been reconciled is recorded in a separate table, not
  /// as a column here. A posted line is immutable (R4), and marking it cleared
  /// would be a change to it — so the fact lives beside the line rather than on
  /// it. See ReconciliationEntry.
  reconciliation  ReconciliationEntry?
  matchedImports  ImportedTransaction[]

  /// R9 is enforced by *additional* composite foreign keys on
  /// (journalId, orgId) and (accountId, orgId), created in raw SQL by
  /// prisma/sql/ledger-integrity.sql.
  ///
  /// They are not modelled as Prisma relations on purpose: Prisma would then own
  /// `orgId` as a relation scalar shared by two relations and refuse to let a
  /// nested create set it. The guarantee belongs in the database either way, and
  /// this keeps the client API usable. The `@@unique([id, orgId])` indexes on
  /// Journal and LedgerAccount exist to be their targets.

  @@unique([journalId, lineNumber])
  /// The index the general ledger, trial balance and every report leans on.
  @@index([orgId, accountId, journalDate, id])
  /// Date-range statements (P&L, cash flow) filter by org + date without an account.
  @@index([orgId, journalDate])
  @@index([journalId])
  @@index([orgId, customerId])
  @@index([orgId, vendorId])
  @@index([orgId, trackingCategoryId])
  @@map("journal_lines")
}

/// One optional reporting dimension (class / location / department).
///
/// QuickBooks calls this a Class. It is not a second ledger and not a project:
/// a name a journal line can carry so profit and loss can be read by shop.
model TrackingCategory {
  id    String @id @default(cuid())
  orgId String

  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  journalLines      JournalLine[]
  salesDocuments    SalesDocument[]
  purchaseDocuments PurchaseDocument[]
  patientVisits     PatientVisit[]
  donorPledges      DonorPledge[]
  budgets           Budget[]

  @@unique([orgId, name])
  /// Target for the composite foreign keys that keep a class inside its company.
  @@unique([id, orgId])
  @@index([orgId, isActive])
  @@map("tracking_categories")
}

// ---------------------------------------------------------------------------
// Master data  (Phase 3)
// ---------------------------------------------------------------------------

/// When a document falls due. Attached to customers and vendors as a default and
/// copied onto each document, so changing a term later never restates the due
/// date of an invoice already sent.
model PaymentTerm {
  id    String @id @default(cuid())
  orgId String

  name String
  type PaymentTermType @default(NET_DAYS)

  /// NET_DAYS: days after the document date. DAY_OF_MONTH: the day it is due.
  dueDays Int @default(30) @db.SmallInt

  /// Early-settlement discount: `discountPercent` off if paid within
  /// `discountDays`. Recorded here in Phase 3; applied in Phase 4.
  discountDays    Int?     @db.SmallInt
  discountPercent Decimal? @db.Decimal(9, 4)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customers         Customer[]
  vendors           Vendor[]
  documents         SalesDocument[]
  purchaseDocuments PurchaseDocument[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("payment_terms")
}

model Customer {
  id    String @id @default(cuid())
  orgId String

  /// What the business calls them. Unique per organisation, because two
  /// "Ahmed" entries on an aging report help nobody.
  displayName String
  companyName String?
  firstName   String?
  lastName    String?

  email  String?
  phone  String?
  mobile String?

  taxRegistrationNumber String?

  billingLine1      String?
  billingLine2      String?
  billingCity       String?
  billingRegion     String?
  billingPostalCode String?
  billingCountry    String? @db.Char(2)

  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingRegion     String?
  shippingPostalCode String?
  shippingCountry    String? @db.Char(2)

  paymentTermId String?
  /// Informational in Phase 3; Phase 4 warns when an invoice would exceed it.
  creditLimit   Decimal? @db.Decimal(19, 4)

  /// Prefer this currency on new sales. Null means the organisation base (ADR-0006).
  currencyCode String? @db.Char(3)

  /// Retail uses the item sales price. Wholesale uses wholesale price when the item has one.
  priceLevel CustomerPriceLevel @default(RETAIL)
  /// Named price list (Pass 1). When set, list prices override RETAIL/WHOLESALE defaults.
  priceListId String?

  notes    String?
  /// Printed on the invoice as Sales person. The person who looks after this customer.
  salesPerson String?
  isActive Boolean @default(true)

  /// The day the debt was agreed. The ledger still uses the balance date.
  agreementDate DateTime? @db.Date
  /// The day the balance falls due. Kept on the customer so a reminder can find it.
  balanceDate   DateTime? @db.Date
  /// Clock time of the balance, as entered on the registration form.
  balanceTime   String?
  /// How many days before the balance time the warning appears. 3, 5, or 7.
  reminderDays  Int?      @db.SmallInt

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paymentTerm  PaymentTerm?  @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  priceList    PriceList?    @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  journalLines JournalLine[]
  documents    SalesDocument[]
  payments     CustomerPayment[]
  deliveryNotes DeliveryNote[]
  files        CustomerFile[]
  importedLines ImportedTransaction[]
  bankRules     BankRule[]
  calendarEvents CalendarEvent[]
  posRegisters  PosRegister[]
  /// Expenses settled by reducing what this customer owes (or building a credit).
  offsetPurchases PurchaseDocument[] @relation("PurchaseOffsetCustomer")
  /// Purchase lines marked to recharge on a later invoice (Phase 11.5).
  billablePurchaseLines PurchaseDocumentLine[] @relation("BillableExpenseCustomer")
  portalUsers  CustomerPortalUser[]
  projects     Project[]
  appointments Appointment[]
  crmOpportunities CrmOpportunity[]
  crmActivities    CrmActivity[]
  stays            Stay[]
  studentEnrollments StudentEnrollment[]
  patientVisits    PatientVisit[]
  donorPledges     DonorPledge[]

  /// Same trading party on the purchase side (e.g. Mall Group as customer and supplier).
  /// One customer ↔ one vendor. Cleared if the vendor is removed.
  linkedVendorId String? @unique
  linkedVendor   Vendor?  @relation("CustomerVendorLink", fields: [linkedVendorId], references: [id], onDelete: SetNull)

  @@unique([orgId, displayName])
  /// Target for the tenancy-carrying composite foreign key on journal_lines (R9).
  @@unique([id, orgId])
  @@index([orgId, isActive, displayName])
  @@index([priceListId])
  @@map("customers")
}

/// Login that may open the customer portal for one customer in one company.
model CustomerPortalUser {
  id         String @id @default(cuid())
  orgId      String
  userId     String
  customerId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId, customerId])
  @@map("customer_portal_users")
}

/// Which list price a customer is charged. Retail is the item sales price.
enum CustomerPriceLevel {
  RETAIL
  WHOLESALE
}

/// A portrait or a debt-agreement paper kept with the customer who was registered.
enum CustomerFileKind {
  PHOTO
  AGREEMENT
}

model CustomerFile {
  id         String           @id @default(cuid())
  orgId      String
  customerId String
  kind       CustomerFileKind
  originalName String
  contentType  String
  byteSize     Int
  /// Path under the uploads directory. Never a public URL.
  storageKey   String
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orgId, customerId, kind])
  @@map("customer_files")
}

model Vendor {
  id    String @id @default(cuid())
  orgId String

  displayName String
  companyName String?
  firstName   String?
  lastName    String?

  email  String?
  phone  String?
  mobile String?

  taxRegistrationNumber String?

  billingLine1      String?
  billingLine2      String?
  billingCity       String?
  billingRegion     String?
  billingPostalCode String?
  billingCountry    String? @db.Char(2)

  paymentTermId String?

  /// Pre-selected on a bill, so routine spending is categorised the same way
  /// every time instead of landing in Uncategorised Expense.
  defaultExpenseAccountId String?

  /// Prefer this currency on new bills. Null means the organisation base (ADR-0006).
  currencyCode String? @db.Char(3)

  notes    String?
  isActive Boolean @default(true)

  /// The day the payable was agreed. Overdue reads this when no balance date was written.
  agreementDate DateTime? @db.Date
  /// The day the vendor balance falls due. Kept so overdue can find the registration promise.
  balanceDate   DateTime? @db.Date
  /// Clock time of the balance, as entered on the registration form.
  balanceTime   String?
  /// How many days before the balance time the warning appears. 3, 5, or 7.
  reminderDays  Int?      @db.SmallInt

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paymentTerm           PaymentTerm?   @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  defaultExpenseAccount LedgerAccount? @relation("VendorDefaultExpense", fields: [defaultExpenseAccountId], references: [id], onDelete: SetNull)
  journalLines          JournalLine[]
  documents             PurchaseDocument[]
  payments              BillPayment[]
  importedLines         ImportedTransaction[]
  bankRules             BankRule[]
  calendarEvents        CalendarEvent[]
  asnShipments          AsnShipment[]
  /// Reverse of Customer.linkedVendorId — same party as a customer.
  linkedCustomer        Customer? @relation("CustomerVendorLink")
  preferredItems        Item[]

  @@unique([orgId, displayName])
  /// Target for the tenancy-carrying composite foreign key on journal_lines (R9).
  @@unique([id, orgId])
  @@index([orgId, isActive, displayName])
  @@map("vendors")
}

model ItemCategory {
  id    String @id @default(cuid())
  orgId String

  name     String
  parentId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     ItemCategory[] @relation("CategoryHierarchy")
  items        Item[]

  @@unique([orgId, name])
  @@map("item_categories")
}

/// A product or service.
///
/// Items carry their account mappings so posting is driven by master data rather
/// than by whoever is typing the invoice. Which mappings are required depends on
/// the type, and the rule is enforced in the service and by a database trigger:
///
///   SERVICE / OTHER_CHARGE   income; expense optional
///   DISCOUNT                 income (sales discounts)
///   NON_INVENTORY            income; purchase cost → system COGS
///   INVENTORY / ASSEMBLY     income + inventory asset + COGS, all required
model Item {
  id    String @id @default(cuid())
  orgId String

  sku         String?
  /// Package code a scanner reads at the till. Empty means the till still sells by SKU.
  barcode     String?
  name        String
  description String?
  type        ItemType @default(NON_INVENTORY)
  categoryId  String?

  unitOfMeasure String?

  salesDescription String?
  salesPrice       Decimal? @db.Decimal(19, 4)
  /// Charged instead of the sales price when the customer is wholesale and this is set.
  wholesalePrice   Decimal? @db.Decimal(19, 4)
  incomeAccountId  String?
  isTaxable        Boolean  @default(true)
  salesTaxCodeId   String?

  purchaseDescription String?
  purchaseCost        Decimal? @db.Decimal(19, 4)
  expenseAccountId    String?
  purchaseTaxCodeId   String?

  /// INVENTORY only. Stock movement and weighted-average cost arrive in Phase 7.
  inventoryAccountId String?
  cogsAccountId      String?
  reorderPoint       Decimal? @db.Decimal(19, 4)

  /// Usual vendor for reorders. Optional; shown on the products list.
  preferredVendorId String?

  /// Phase 24: receive/issue must name a lot (batch) when true.
  trackLots Boolean @default(false)
  /// Phase 24: each unit needs a unique serial on receive/issue when true.
  trackSerials Boolean @default(false)
  /// Pharmacy: controlled / Rx stock — requires a lot on sale; refuses expired lots.
  pharmacyControlled Boolean @default(false)

  /// Which store holds this product. The store has its own inventory account.
  storeId String?

  isActive Boolean @default(true)

  /// When true, the item appears on the point-of-sale product grid.
  availableInPos Boolean @default(true)

  /// GROUP: print member lines on the invoice.
  printGroupItems Boolean @default(true)

  /// PAYMENT item: cash / card / … (QuickBooks payment item).
  itemPaymentMethod PaymentMethod?

  /// PAYMENT item: Undeposited Funds or a bank account.
  depositAccountId String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category         ItemCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  incomeAccount    LedgerAccount? @relation("ItemIncome", fields: [incomeAccountId], references: [id], onDelete: Restrict)
  expenseAccount   LedgerAccount? @relation("ItemExpense", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  inventoryAccount LedgerAccount? @relation("ItemInventory", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  cogsAccount      LedgerAccount? @relation("ItemCogs", fields: [cogsAccountId], references: [id], onDelete: Restrict)
  depositAccount   LedgerAccount? @relation("ItemDeposit", fields: [depositAccountId], references: [id], onDelete: Restrict)
  store            Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  preferredVendor  Vendor?        @relation(fields: [preferredVendorId], references: [id], onDelete: SetNull)
  salesTaxCode     TaxCode?       @relation("ItemSalesTax", fields: [salesTaxCodeId], references: [id], onDelete: SetNull)
  purchaseTaxCode  TaxCode?       @relation("ItemPurchaseTax", fields: [purchaseTaxCodeId], references: [id], onDelete: SetNull)
  salesLines       SalesDocumentLine[]
  purchaseLines    PurchaseDocumentLine[]
  movements        InventoryTransaction[]
  adjustmentLines  InventoryAdjustmentLine[]
  assemblyBuilds   AssemblyBuild[] @relation("AssemblyBuildItem")
  assemblyBuildLines AssemblyBuildLine[]
  workOrders       WorkOrder[] @relation("WorkOrderItem")
  workOrderLines   WorkOrderLine[] @relation("WorkOrderLineItem")
  storeTransfers   StoreTransfer[]
  storeTickets     StoreTicket[]
  deliveryNoteLines DeliveryNoteLine[]
  bomParents       ItemComponent[] @relation("ItemBomParent")
  bomChildren      ItemComponent[] @relation("ItemBomChild")
  pickTasks        PickTask[]
  binMovements     BinMovement[]
  putawayTasks     PutawayTask[]
  roomTypes        RoomType[]  @relation("RoomTypeRateItem")
  folioLines       FolioLine[]
  lots             ItemLot[]
  feePlanLines     FeePlanLine[]
  visitCharges     VisitCharge[]
  routingSteps     RoutingStep[]
  asnShipmentLines AsnShipmentLine[]
  priceListItems   PriceListItem[]
  promotions       ItemPromotion[]

  @@unique([orgId, name])
  @@unique([orgId, sku])
  @@unique([orgId, barcode])
  @@index([orgId, isActive, name])
  @@index([orgId, type])
  @@index([orgId, deletedAt])
  @@index([orgId, storeId])
  @@index([orgId, preferredVendorId])
  @@index([orgId, pharmacyControlled])
  @@map("items")
}

/// Pharmacy / batch registry: lot number → expiry (Phase pharmacy).
model ItemLot {
  id         String    @id @default(cuid())
  orgId      String
  itemId     String
  lotNumber  String
  expiryDate DateTime? @db.Date
  /// When set, lot was written off (expired disposal).
  disposedAt DateTime? @db.Timestamptz(6)
  disposedQuantity Decimal? @db.Decimal(19, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([orgId, itemId, lotNumber])
  @@index([orgId, expiryDate])
  @@index([itemId, expiryDate])
  @@index([orgId, disposedAt])
  @@map("item_lots")
}

/// Members of a GROUP or bill-of-materials lines of an INVENTORY_ASSEMBLY.
model ItemComponent {
  id              String  @id @default(cuid())
  orgId           String
  parentItemId    String
  componentItemId String
  quantity        Decimal @db.Decimal(19, 4)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  parent    Item @relation("ItemBomParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  component Item @relation("ItemBomChild", fields: [componentItemId], references: [id], onDelete: Restrict)

  @@unique([parentItemId, componentItemId])
  @@index([orgId, parentItemId])
  @@map("item_components")
}

/// A place the stock is kept. Each store has an inventory account of its own,
/// named with the store, listed with Inventory Asset on the chart.
model Store {
  id    String @id @default(cuid())
  orgId String

  name               String
  inventoryAccountId String
  isActive           Boolean @default(true)
  /// The office. Stock recorded before a store was chosen is counted here.
  isOffice           Boolean @default(false)

  /// Where the store sits — street / area.
  address String?
  /// Store phone so staff can reach that location.
  phone   String?
  /// Person who holds the physical key to this store.
  keyHolderName  String?
  /// Phone for the key holder (may differ from the store phone).
  keyHolderPhone String?
  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      LedgerAccount          @relation("StoreAccount", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  items        Item[]
  movements    InventoryTransaction[]
  salesLines   SalesDocumentLine[]
  purchaseLines PurchaseDocumentLine[]
  transfersOut StoreTransfer[] @relation("TransferFrom")
  transfersIn  StoreTransfer[] @relation("TransferTo")
  tickets      StoreTicket[]
  ticketsIn    StoreTicket[]   @relation("TicketToStore")
  deliveryNotes DeliveryNote[]
  assemblyBuilds AssemblyBuild[]
  workOrders    WorkOrder[]
  adjustments  InventoryAdjustment[]
  posRegisters  PosRegister[]
  bins          StockBin[]
  pickTasks     PickTask[]
  putawayTasks  PutawayTask[]
  workCenters   WorkCenter[]
  siteProjects  Project[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("stores")
}

// ---------------------------------------------------------------------------
// Point of sale
// ---------------------------------------------------------------------------

/// A way to take money at the till — mobile wallet, cash drawer, etc.
/// The orders report totals by this method. The money posts to the register's
/// bank account, not to this method's account.
model PosPaymentMethod {
  id              String @id @default(cuid())
  orgId           String

  name            String
  ledgerAccountId String
  /// Cashiers may hand change back from this method. The till can still turn it off.
  allowsChangeReturn Boolean @default(true)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0) @db.SmallInt

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation("PosPaymentAccount", fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  registers    PosRegisterMethod[]
  payments     PosOrderPayment[]
  changeOrders PosOrder[] @relation("PosChangeMethod")
  defaultOnRegisters PosRegister[] @relation("RegisterDefaultChange")

  @@unique([orgId, name])
  @@index([orgId, isActive, sortOrder])
  @@map("pos_payment_methods")
}

/// A physical or logical till. Links a default walk-in customer, store, and
/// its own bank sub-account under the POS Banks heading.
model PosRegister {
  id                String @id @default(cuid())
  orgId             String

  name              String
  storeId           String?
  defaultCustomerId String
  /// BANK sub-account under POS Banks. Nullable until the backfill runs.
  /// New sales debit this account. It keeps the balance until someone transfers it out.
  ledgerAccountId   String? @unique
  isActive          Boolean @default(true)
  /// Till setting: which method is selected when the Payment dialog opens. Null means cash.
  defaultChangeMethodId String?
  /// When off, change can only come back from a cash method, even if wallets are allowed below.
  allowWalletChangeReturn Boolean @default(true)

  /// bcrypt hash of the cashier PIN. Null until an admin sets one; those tills stay openable.
  pinHash String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store           Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  defaultCustomer Customer     @relation(fields: [defaultCustomerId], references: [id], onDelete: Restrict)
  account         LedgerAccount? @relation("PosRegisterBank", fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  defaultChangeMethod PosPaymentMethod? @relation("RegisterDefaultChange", fields: [defaultChangeMethodId], references: [id], onDelete: SetNull)
  methods         PosRegisterMethod[]
  staff           PosRegisterStaff[]
  sessions        PosSession[]
  orders          PosOrder[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@index([defaultChangeMethodId])
  @@map("pos_registers")
}

/// Who may work this counter. Empty = managers only; cashiers must be listed.
model PosRegisterStaff {
  registerId String
  userId     String

  register PosRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([registerId, userId])
  @@index([userId])
  @@map("pos_register_staff")
}

/// A cash-control period on one register — open with opening float, close with counted cash.
model PosSession {
  id             String           @id @default(cuid())
  orgId          String
  registerId     String
  status         PosSessionStatus @default(OPEN)

  openedAt       DateTime @default(now()) @db.Timestamptz(6)
  closedAt       DateTime? @db.Timestamptz(6)
  openingCash    Decimal  @default(0) @db.Decimal(19, 4)
  closingCash    Decimal? @db.Decimal(19, 4)
  /// Expected drawer cash at close (opening + cash sales − refunds ± moves).
  expectedCashAtClose Decimal? @db.Decimal(19, 4)
  /// counted − expected. Positive = over, negative = short.
  cashDifference      Decimal? @db.Decimal(19, 4)
  closingJournalId    String?  @unique

  openedByUserId String
  closedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  register       PosRegister  @relation(fields: [registerId], references: [id], onDelete: Restrict)
  closingJournal Journal?     @relation("PosSessionCloseJournal", fields: [closingJournalId], references: [id], onDelete: Restrict)
  orders         PosOrder[]
  cashMoves      PosCashMovement[]

  @@index([orgId, status, openedAt(sort: Desc)])
  @@index([registerId, status])
  @@map("pos_sessions")
}

/// Manual cash put into / taken from the drawer during an open session.
model PosCashMovement {
  id                    String          @id @default(cuid())
  orgId                 String
  sessionId             String
  kind                  PosCashMoveKind
  amount                Decimal         @db.Decimal(19, 4)
  reason                String?
  /// Bank / wallet the cash came from (IN) or went to (OUT). Null on older drawer-only rows.
  counterpartyAccountId String?
  journalId             String?         @unique
  createdByUserId       String
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)

  session      PosSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  counterparty LedgerAccount? @relation("PosCashMoveCounterparty", fields: [counterpartyAccountId], references: [id], onDelete: Restrict)
  journal      Journal?       @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("pos_cash_movements")
}

model PosRegisterMethod {
  registerId      String
  paymentMethodId String
  /// This till may hand change back from this method. Combined with the method's own flag.
  allowsChangeReturn Boolean @default(true)

  register      PosRegister      @relation(fields: [registerId], references: [id], onDelete: Cascade)
  paymentMethod PosPaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@id([registerId, paymentMethodId])
  @@map("pos_register_methods")
}

/// Links a posted sales receipt back to the till that raised it.
model PosOrder {
  id              String @id @default(cuid())
  orgId           String
  registerId      String
  sessionId       String?
  salesDocumentId String @unique

  /// Money handed back. Zero on sales rung up before change was recorded, and on exact tenders.
  changeAmount            Decimal @default(0) @db.Decimal(19, 4)
  changePaymentMethodId   String?
  changeLedgerAccountId   String?
  /// Register bank account this order posts to. Null on receipts posted before
  /// tills had their own bank account; those journals stay on the wallet accounts.
  depositLedgerAccountId  String?
  /// Tip collected with the sale (held in TIP_LIABILITY). Not sale revenue.
  tipAmount               Decimal @default(0) @db.Decimal(19, 4)
  tipJournalId            String? @unique
  diningTableId           String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  register      PosRegister       @relation(fields: [registerId], references: [id], onDelete: Restrict)
  session       PosSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  salesDocument SalesDocument     @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)
  changePaymentMethod PosPaymentMethod? @relation("PosChangeMethod", fields: [changePaymentMethodId], references: [id], onDelete: Restrict)
  changeAccount       LedgerAccount?    @relation("PosChangeAccount", fields: [changeLedgerAccountId], references: [id], onDelete: Restrict)
  depositAccount      LedgerAccount?    @relation("PosOrderDeposit", fields: [depositLedgerAccountId], references: [id], onDelete: Restrict)
  tipJournal          Journal?          @relation("PosOrderTipJournal", fields: [tipJournalId], references: [id], onDelete: Restrict)
  diningTable         DiningTable?      @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  payments      PosOrderPayment[]
  kitchenTickets KitchenTicket[]

  @@index([orgId, registerId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([changePaymentMethodId])
  @@index([depositLedgerAccountId])
  @@index([diningTableId])
  @@map("pos_orders")
}

model PosOrderPayment {
  id              String @id @default(cuid())
  orderId         String
  paymentMethodId String
  ledgerAccountId String
  amount          Decimal @db.Decimal(19, 4)

  order         PosOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod PosPaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("pos_order_payments")
}

// ---------------------------------------------------------------------------
// Tax  (Phase 3 defines it; Phase 4 posts it)
// ---------------------------------------------------------------------------

/// Who the tax is owed to, and how often it is filed.
model TaxAgency {
  id    String @id @default(cuid())
  orgId String

  name             String
  registrationNumber String?
  filingFrequency  TaxFilingFrequency @default(MONTHLY)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rates        TaxRate[]

  @@unique([orgId, name])
  @@map("tax_agencies")
}

/// A single percentage owed to one agency.
///
/// The rate is stored as a fraction (0.15, not 15) at nine decimal places, so a
/// third-of-a-percent levy does not have to be rounded before it is applied.
model TaxRate {
  id    String @id @default(cuid())
  orgId String

  name     String
  rate     Decimal        @db.Decimal(19, 9)
  agencyId String
  appliesTo TaxApplication @default(BOTH)

  /// Where the tax lands. Sales tax collected is a liability; purchase tax is an
  /// asset where it is recoverable, and simply part of the cost where it is not.
  salesAccountId    String?
  purchaseAccountId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agency          TaxAgency      @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  salesAccount    LedgerAccount? @relation("TaxRateSales", fields: [salesAccountId], references: [id], onDelete: Restrict)
  purchaseAccount LedgerAccount? @relation("TaxRatePurchase", fields: [purchaseAccountId], references: [id], onDelete: Restrict)
  components      TaxCodeRate[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("tax_rates")
}

/// What a user picks on a document line. One code combines one or more rates,
/// which is what makes compound and multi-jurisdiction tax expressible.
model TaxCode {
  id    String @id @default(cuid())
  orgId String

  name        String
  description String?

  /// True when the price a customer sees already contains the tax, and the tax
  /// must be extracted from it rather than added to it.
  isInclusive Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  components    TaxCodeRate[]
  salesItems    Item[]        @relation("ItemSalesTax")
  purchaseItems Item[]        @relation("ItemPurchaseTax")
  salesLines    SalesDocumentLine[]
  purchaseLines PurchaseDocumentLine[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("tax_codes")
}

/// One rate's part in one code.
model TaxCodeRate {
  id        String @id @default(cuid())
  orgId     String
  taxCodeId String
  taxRateId String

  /// Order of application. A compound rate is charged on the running total
  /// including the rates before it, so the sequence changes the answer.
  sequence   Int     @default(1) @db.SmallInt
  isCompound Boolean @default(false)

  taxCode TaxCode @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)
  taxRate TaxRate @relation(fields: [taxRateId], references: [id], onDelete: Restrict)

  @@unique([taxCodeId, taxRateId])
  @@index([taxCodeId, sequence])
  @@map("tax_code_rates")
}

// ---------------------------------------------------------------------------
// Sales  (Phase 4)
// ---------------------------------------------------------------------------

/// Every customer-facing document. See `SalesDocumentType` for why they share a
/// table.
///
/// Totals are stored, not derived. They are what the customer was shown and what
/// A customer job folder (Projects app). Groups estimates, orders, invoices,
/// POs and bills for one site of work — not a task board.
model Project {
  id    String @id @default(cuid())
  orgId String

  number String
  name   String

  customerId String
  /// Site / delivery address for the job, free text.
  siteLocation String?
  description  String?

  status ProjectStatus @default(DRAFT)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  /// Construction / services: contract value for progress billing.
  contractValue Decimal? @db.Decimal(19, 4)
  /// Construction: retention % held on progress invoices (0–100).
  retentionPercent Decimal? @db.Decimal(7, 4)
  /// Cumulative progress % already billed (0–100).
  billedPercent Decimal @default(0) @db.Decimal(7, 4)
  /// Professional services: retainer balance held (memo; billed via retainer invoices).
  retainerAmount Decimal? @db.Decimal(19, 4)
  /// Construction site store — stock issued / transferred to the job.
  storeId String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  salesDocuments    SalesDocument[]
  purchaseDocuments PurchaseDocument[]
  tasks             ProjectTask[]
  timeEntries       ProjectTimeEntry[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, status, updatedAt(sort: Desc)])
  @@index([orgId, customerId, updatedAt(sort: Desc)])
  @@index([storeId])
  @@map("projects")
}

/// A task on a project — Odoo-style kanban card (to do → in progress → done).
model ProjectTask {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  name        String
  description String?
  stage       ProjectTaskStage @default(TODO)
  /// Order within the stage column (lower = higher on the board).
  sequence    Int              @default(0)

  assigneeId String?
  deadline   DateTime? @db.Date

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  timeEntries  ProjectTimeEntry[]

  @@index([orgId, projectId, stage, sequence])
  @@index([orgId, assigneeId, stage])
  @@map("project_tasks")
}

/// Hours worked on a project, optionally billable onto a later invoice.
model ProjectTimeEntry {
  id        String @id @default(cuid())
  orgId     String
  projectId String
  taskId    String?

  userId String
  workDate DateTime @db.Date
  hours    Decimal  @db.Decimal(19, 4)
  description String?

  billable     Boolean  @default(true)
  /// Charge-out rate in organisation base currency (per hour).
  billableRate Decimal? @db.Decimal(19, 4)

  /// When set, this entry was pulled onto an invoice line and must not be billed again.
  invoicedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user         User         @relation("ProjectTimeEntryUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId, projectId, workDate(sort: Desc)])
  @@index([orgId, billable, invoicedAt])
  @@map("project_time_entries")
}

/// Company asks the ERP system owner for apps beyond the current grant.
model AppAccessRequest {
  id    String @id @default(cuid())
  orgId String

  /// Apps asked for. Shape: `Record<ModuleFlag, boolean>`.
  requestedModules Json
  note             String?

  status AppAccessRequestStatus @default(PENDING)

  requestedById String
  reviewedAt    DateTime? @db.Timestamptz(6)
  reviewedById  String?
  reviewNote    String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("AppAccessRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("AppAccessReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([orgId, status, createdAt(sort: Desc)])
  @@map("app_access_requests")
}

/// A memorised bill, expense, journal, or invoice that posts on a schedule (Phase 11.2 / 36).
model RecurringTemplate {
  id    String @id @default(cuid())
  orgId String

  name      String
  type      RecurringDocType
  frequency RecurringFrequency
  /// Every N weeks/months (1 = every period).
  interval  Int @default(1)

  nextRunOn DateTime  @db.Date
  endOn     DateTime? @db.Date
  isActive  Boolean   @default(true)

  /// Create payload without `date` — ManualJournalInput, PurchaseDocumentInput, or SalesDocumentInput shape.
  payload Json

  /// Phase 36: after an INVOICE posts, move net to unearned and recognize over serviceMonths.
  deferRevenue  Boolean @default(false)
  /// Months to recognize deferred revenue (1–60). Null/0 = no deferral schedule.
  serviceMonths Int?

  lastRunOn         DateTime? @db.Date
  lastDocumentId    String?
  lastDocumentKind  String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("RecurringCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deferredSchedules DeferredRevenueSchedule[]

  @@index([orgId, isActive, nextRunOn])
  @@index([orgId, type, isActive, nextRunOn])
  @@index([orgId, updatedAt(sort: Desc)])
  @@map("recurring_templates")
}

/// Phase 36: remaining unearned revenue from a deferred subscription invoice.
model DeferredRevenueSchedule {
  id     String @id @default(cuid())
  orgId  String

  recurringTemplateId String?
  salesDocumentId     String

  /// Net amount moved into unearned (excludes tax).
  totalAmount       Decimal @db.Decimal(19, 4)
  recognizedAmount  Decimal @default(0) @db.Decimal(19, 4)
  serviceMonths     Int
  serviceStartOn    DateTime @db.Date
  nextRecognizeOn   DateTime @db.Date
  isComplete        Boolean  @default(false)

  /// Journal that moved income → unearned when the invoice posted.
  deferralJournalId     String?
  /// Last recognition journal.
  lastRecognitionJournalId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  @@index([orgId, isComplete, nextRecognizeOn])
  @@index([salesDocumentId])
  @@map("deferred_revenue_schedules")
}

/// the ledger was told, and recomputing them later from prices that may since
/// have changed would quietly restate a document that has already been sent.
/// The **outstanding balance** is the opposite: always derived from applications,
/// so it cannot drift.
model SalesDocument {
  id    String @id @default(cuid())
  orgId String

  type   SalesDocumentType
  number String

  customerId String
  date       DateTime  @db.Date
  dueDate    DateTime? @db.Date
  /// Copied from the customer at creation, so changing a term later never
  /// restates the due date of a document already sent.
  paymentTermId String?
  expiryDate    DateTime? @db.Date

  /// Customer promised to pay by this date. Used for overdue lists instead of dueDate.
  promisedDate DateTime? @db.Date
  /// Note from the last payment promise (who agreed, how, phone call, …).
  promiseNote  String?
  /// When true, the invoice stays open but leaves overdue / collections lists (“un overdue”).
  excludeFromOverdue Boolean @default(false)

  status SalesDocumentStatus @default(DRAFT)

  /// Customer P.O. NO. (QuickBooks PONumber).
  reference       String?
  /// Template field IN/ — GRN / internal refs (QuickBooks custom or Other).
  inRef           String?
  memo            String?
  customerMessage String?
  /// Nature / section of work on a quotation or estimate (e.g. foundation works
  /// on a construction job). Printed with the customer name so each priced part
  /// of a project is labeled clearly.
  workScope       String?
  /// Place the work is done. Printed below Sales person on the quotation paper.
  workSite        String?

  subtotal Decimal @default(0) @db.Decimal(19, 4)
  discountAmount Decimal @default(0) @db.Decimal(19, 4)
  taxTotal Decimal @default(0) @db.Decimal(19, 4)
  total    Decimal @default(0) @db.Decimal(19, 4)

  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  /// Where the money landed, for documents that move cash immediately.
  /// Required for SALES_RECEIPT and REFUND_RECEIPT, unused otherwise.
  depositAccountId String?
  /// How a sales receipt was paid. Unused on every other sales document.
  paymentMethod PaymentMethod?

  /// The journal currently representing this document. Null for drafts and
  /// estimates. An edit reverses the old journal and points this at the new one.
  journalId String?
  /// Bumped on every re-post, so the audit trail can be read in order.
  version   Int    @default(1)

  /// Set on an invoice (or receipt) raised from an estimate, quotation, or sales
  /// order. Not unique: progress invoicing allows several invoices per source
  /// (Phase 11.4), mirroring many bills per purchase order.
  convertedFromId String?

  /// Optional job this sale belongs to (Projects app).
  projectId String?

  /// Optional class. Stamped onto every journal line when the document posts.
  trackingCategoryId String?

  /// Pharmacy: optional prescription / Rx reference (text only — not e-Rx).
  prescriptionRef String?

  /// Construction: retention held on this invoice (recognised on GL as receivable).
  retentionAmount Decimal? @db.Decimal(19, 4)
  /// Construction: progress % this invoice represents (0–100).
  progressPercent Decimal? @db.Decimal(7, 4)
  /// When retention was released into AR (Dr AR / Cr retention receivable).
  retentionReleasedAt DateTime? @db.Timestamptz(6)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentTerm    PaymentTerm?        @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  depositAccount LedgerAccount?      @relation("SalesDepositAccount", fields: [depositAccountId], references: [id], onDelete: Restrict)
  journal        Journal?            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  trackingCategory TrackingCategory? @relation(fields: [trackingCategoryId], references: [id], onDelete: SetNull)
  lines          SalesDocumentLine[]

  convertedFrom SalesDocument?  @relation("EstimateConversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  convertedTo   SalesDocument[] @relation("EstimateConversion")

  /// Applications *against* this document — what has settled it.
  applications    SalesApplication[] @relation("AppliedToInvoice")
  /// Applications *from* this document, when it is a credit memo.
  creditsApplied  SalesApplication[] @relation("AppliedFromCredit")

  deliveryNotes DeliveryNote[]
  storeTickets  StoreTicket[]
  posOrder      PosOrder?
  folio         Folio?
  studentEnrollment StudentEnrollment?
  patientVisit  PatientVisit?
  files         LedgerFile[]

  @@unique([orgId, type, number])
  @@unique([id, orgId])
  @@index([orgId, type, status, date(sort: Desc)])
  @@index([orgId, customerId, date(sort: Desc)])
  @@index([orgId, projectId, date(sort: Desc)])
  @@index([orgId, dueDate])
  @@index([orgId, deletedAt])
  @@index([convertedFromId])
  @@map("sales_documents")
}

model SalesDocumentLine {
  id         String @id @default(cuid())
  documentId String
  orgId      String

  lineNumber Int @db.SmallInt

  itemId      String?
  description String?

  quantity  Decimal @default(1) @db.Decimal(19, 4)
  unitPrice Decimal @default(0) @db.Decimal(19, 4)

  /// How much of this line has been invoiced. Meaningful on estimates,
  /// quotations, and sales orders — the only writers are progress-invoice
  /// and delete/restore (Phase 11.4), mirroring `quantityReceived` on POs.
  quantityInvoiced Decimal @default(0) @db.Decimal(19, 4)

  /// Line-level discount, taken off before tax.
  discountPercent Decimal? @db.Decimal(9, 4)

  /// quantity x unitPrice, less the discount. Tax-exclusive.
  amount Decimal @default(0) @db.Decimal(19, 4)

  taxCodeId String?
  taxAmount Decimal @default(0) @db.Decimal(19, 4)

  /// Resolved from the item at posting time and frozen here, so re-reading the
  /// document years later shows where the money actually went, even if the item
  /// has since been remapped.
  incomeAccountId String?

  /// The store this line is issued from, or returned to.
  storeId String?

  /// Phase 24: lot / serial for tracked inventory on this issue line.
  lotNumber    String?
  serialNumber String?
  /// Pharmacy: expiry recorded/validated for this lot on the sale line.
  lotExpiryDate DateTime? @db.Date

  serviceDate DateTime? @db.Date

  /// When this invoice line recharged a purchase cost (Phase 11.5).
  sourcePurchaseLineId String? @unique

  document      SalesDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item          Item?          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode       TaxCode?       @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  incomeAccount LedgerAccount? @relation("SalesLineIncome", fields: [incomeAccountId], references: [id], onDelete: Restrict)
  store         Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  sourcePurchaseLine PurchaseDocumentLine? @relation("BillableExpenseInvoice", fields: [sourcePurchaseLineId], references: [id], onDelete: SetNull)

  @@unique([documentId, lineNumber])
  @@index([orgId, itemId])
  @@map("sales_document_lines")
}

/// Money received from a customer.
///
/// A payment is not "an invoice marked paid": it is its own document, which may
/// settle several invoices, part of one, or none at all. Unapplied cash sits on
/// the balance sheet as a customer credit, which is exactly where it belongs.
model CustomerPayment {
  id    String @id @default(cuid())
  orgId String

  number     String
  customerId String
  date       DateTime @db.Date

  amount Decimal @db.Decimal(19, 4)

  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  memo      String?

  /// Bank account, or Undeposited Funds when the money is in hand but not yet
  /// taken to the bank.
  depositAccountId String

  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  journalId String?
  status    SalesDocumentStatus @default(OPEN)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  depositAccount LedgerAccount      @relation("PaymentDepositAccount", fields: [depositAccountId], references: [id], onDelete: Restrict)
  journal        Journal?           @relation(fields: [journalId], references: [id], onDelete: Restrict)
  applications   SalesApplication[]
  depositLines   DepositLine[]
  donorPledges   DonorPledge[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, customerId, date(sort: Desc)])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@map("customer_payments")
}

/// What settled what.
///
/// An invoice's outstanding balance is `total - sum(applications)`. Keeping that
/// derived rather than stored is what allows partial payments, one payment across
/// many invoices, credit memos used as payment and unapplied cash — without any
/// of them being a special case, and without a stored figure that can drift.
///
/// Exactly one source: a payment, or a credit memo. A CHECK enforces it.
model SalesApplication {
  id    String @id @default(cuid())
  orgId String

  paymentId        String?
  creditDocumentId String?

  invoiceId String
  amount    Decimal @db.Decimal(19, 4)

  appliedAt DateTime @default(now()) @db.Timestamptz(6)

  payment        CustomerPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  creditDocument SalesDocument?   @relation("AppliedFromCredit", fields: [creditDocumentId], references: [id], onDelete: Cascade)
  invoice        SalesDocument    @relation("AppliedToInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@unique([creditDocumentId, invoiceId])
  @@index([orgId, invoiceId])
  @@map("sales_applications")
}

// ---------------------------------------------------------------------------
// Purchases  (Phase 5)
// ---------------------------------------------------------------------------

/// Bills, expenses, vendor credits, purchase orders, PRs and RFQs.
///
/// Deliberately the mirror of `SalesDocument`, field for field where the meaning
/// is the same. Two subledgers that behave differently is a source of bugs and of
/// arguments; two that behave identically is one thing to learn.
model PurchaseDocument {
  id    String @id @default(cuid())
  orgId String

  type   PurchaseDocumentType
  number String

  /// Optional on PURCHASE_REQUEST (internal ask). Required for RFQ, PO, bills.
  vendorId String?
  date     DateTime  @db.Date
  dueDate  DateTime? @db.Date
  /// Copied from the vendor at creation, so changing a term later never restates
  /// the due date of a bill already entered.
  paymentTermId String?
  expiryDate    DateTime? @db.Date

  status PurchaseDocumentStatus @default(DRAFT)

  /// Vendor P.O. NO. / their reference on the bill.
  reference String?
  /// Template field IN/ — GRN / internal refs (QuickBooks-style).
  inRef     String?
  memo      String?

  subtotal Decimal @default(0) @db.Decimal(19, 4)
  taxTotal Decimal @default(0) @db.Decimal(19, 4)
  total    Decimal @default(0) @db.Decimal(19, 4)

  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  /// Where the money came from. Required for EXPENSE unless settled on a customer.
  paymentAccountId String?

  /// When set on an EXPENSE, the cost is credited to this customer's receivable
  /// instead of (or as well as) a bank account — buy from their shop or pay an
  /// expense by deducting the balance they owe you. A credit above their balance
  /// leaves a credit on their account to pay later.
  offsetCustomerId String?

  journalId String?
  version   Int    @default(1)

  /// Set on each bill raised against a purchase order, and on RFQ/PO converted
  /// from a PR or RFQ (sales-style close).
  ///
  /// Not unique. An order is rarely filled in one delivery: half the pallets
  /// arrive on Tuesday and the rest a fortnight later, and each arrival is its
  /// own bill against the same order. Requiring one bill per order is what
  /// forced the whole order to be received at once whether or not it had all
  /// turned up.
  convertedFromId String?

  /// Phase 23: why a bill linked to a PO is on MATCH_HOLD (qty/price vs order/receive).
  matchVarianceNote String?
  /// When set, postDocument skips the hard 3-way check (variance already approved).
  matchVarianceApproved Boolean @default(false)
  matchApprovedAt       DateTime? @db.Timestamptz(6)
  matchApprovedById     String?

  /// Optional job this purchase belongs to (Projects app).
  projectId String?

  /// Optional class. Stamped onto every journal line when the document posts.
  trackingCategoryId String?

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor         Vendor?                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paymentTerm    PaymentTerm?           @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  paymentAccount LedgerAccount?         @relation("PurchasePaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)
  offsetCustomer Customer?              @relation("PurchaseOffsetCustomer", fields: [offsetCustomerId], references: [id], onDelete: Restrict)
  journal        Journal?               @relation(fields: [journalId], references: [id], onDelete: Restrict)
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  trackingCategory TrackingCategory?    @relation(fields: [trackingCategoryId], references: [id], onDelete: SetNull)
  lines          PurchaseDocumentLine[]

  convertedFrom PurchaseDocument?  @relation("OrderConversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  /// The bills raised against this order, oldest first.
  convertedTo   PurchaseDocument[] @relation("OrderConversion")

  applications   PurchaseApplication[] @relation("AppliedToBill")
  creditsApplied PurchaseApplication[] @relation("AppliedFromVendorCredit")
  files          LedgerFile[]
  asnShipments   AsnShipment[]

  @@unique([orgId, type, number])
  @@unique([id, orgId])
  @@index([orgId, type, status, date(sort: Desc)])
  @@index([orgId, vendorId, date(sort: Desc)])
  @@index([orgId, projectId, date(sort: Desc)])
  @@index([orgId, offsetCustomerId, date(sort: Desc)])
  @@index([orgId, dueDate])
  @@index([convertedFromId])
  @@index([orgId, deletedAt])
  @@map("purchase_documents")
}

model PurchaseDocumentLine {
  id         String @id @default(cuid())
  documentId String
  orgId      String

  lineNumber Int @db.SmallInt

  itemId      String?
  description String?

  quantity  Decimal @default(1) @db.Decimal(19, 4)
  unitPrice Decimal @default(0) @db.Decimal(19, 4)

  /// How much of this line has arrived. Only meaningful on a purchase order,
  /// where it is what separates "ordered" from "still to come".
  ///
  /// It is kept on the order rather than derived from the bills raised against
  /// it because a bill can be edited or voided after the fact, and an order that
  /// silently re-opened itself when somebody corrected a bill would be worse
  /// than one that never closed. The receiving service is the only writer.
  quantityReceived Decimal @default(0) @db.Decimal(19, 4)

  discountPercent Decimal? @db.Decimal(9, 4)

  amount Decimal @default(0) @db.Decimal(19, 4)

  taxCodeId String?
  taxAmount Decimal @default(0) @db.Decimal(19, 4)

  /// Where the cost lands: an expense account, or an asset account for something
  /// capitalised. Resolved at posting time and frozen, so re-reading the bill
  /// years later shows where the money actually went.
  expenseAccountId String?

  /// The store this line is received into, or returned from.
  storeId String?

  /// Phase 24: lot / serial for tracked inventory on this receipt line.
  lotNumber    String?
  serialNumber String?
  /// Pharmacy: expiry for the received lot (upserts ItemLot).
  lotExpiryDate DateTime? @db.Date

  /// Customer to recharge this cost on a later invoice (Phase 11.5). Mutually
  /// exclusive with document-level `offsetCustomerId` (pay-from-AR now).
  billableCustomerId String?
  /// Unit price when pulled onto an invoice; defaults to the cost line amount.
  billableUnitPrice  Decimal? @db.Decimal(19, 4)

  document        PurchaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item            Item?            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode         TaxCode?         @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  expenseAccount  LedgerAccount?   @relation("PurchaseLineExpense", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  store           Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  billableCustomer Customer?       @relation("BillableExpenseCustomer", fields: [billableCustomerId], references: [id], onDelete: SetNull)
  billedInvoiceLine SalesDocumentLine? @relation("BillableExpenseInvoice")

  @@unique([documentId, lineNumber])
  @@index([orgId, itemId])
  @@index([orgId, billableCustomerId])
  @@map("purchase_document_lines")
}

/// Money paid to a vendor. The mirror of `CustomerPayment`.
model BillPayment {
  id    String @id @default(cuid())
  orgId String

  number   String
  vendorId String
  date     DateTime @db.Date

  amount Decimal @db.Decimal(19, 4)

  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  memo      String?

  /// Bank or credit card the money left from.
  paymentAccountId String

  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  journalId String?
  status    PurchaseDocumentStatus @default(OPEN)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor         Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paymentAccount LedgerAccount         @relation("BillPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)
  journal        Journal?              @relation(fields: [journalId], references: [id], onDelete: Restrict)
  applications   PurchaseApplication[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, vendorId, date(sort: Desc)])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@map("bill_payments")
}

/// What settled which bill. Exactly one source: a payment, or a vendor credit.
model PurchaseApplication {
  id    String @id @default(cuid())
  orgId String

  paymentId        String?
  creditDocumentId String?

  billId String
  amount Decimal @db.Decimal(19, 4)

  appliedAt DateTime @default(now()) @db.Timestamptz(6)

  payment        BillPayment?      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  creditDocument PurchaseDocument? @relation("AppliedFromVendorCredit", fields: [creditDocumentId], references: [id], onDelete: Cascade)
  bill           PurchaseDocument  @relation("AppliedToBill", fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@unique([creditDocumentId, billId])
  @@index([orgId, billId])
  @@map("purchase_applications")
}

// ---------------------------------------------------------------------------
// Banking  (Phase 6)
// ---------------------------------------------------------------------------

/// Money moved between two of the business's own accounts.
///
/// Not income, not an expense — nothing has been earned or spent, so this posts
/// only between two asset or liability accounts. Recording a transfer as a sale
/// on one side and a purchase on the other is one of the commonest ways a set of
/// books ends up overstating both.
model BankTransfer {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  fromAccountId String
  toAccountId   String
  amount        Decimal @db.Decimal(19, 4)

  memo      String?
  reference String?

  currencyCode String @db.Char(3)

  journalId String?
  status    BankDocumentStatus @default(POSTED)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fromAccount  LedgerAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount    LedgerAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  journal      Journal?      @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, deletedAt])
  @@map("bank_transfers")
}

/// Taking money to the bank.
///
/// Payments received into Undeposited Funds sit there until someone physically
/// banks them. A deposit clears that holding account and puts the money where the
/// bank statement will show it — which is what makes the register match the
/// statement line for line, rather than showing five payments where the bank
/// shows one paying-in slip.
model Deposit {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  bankAccountId String
  total         Decimal @db.Decimal(19, 4)

  memo      String?
  reference String?

  currencyCode String @db.Char(3)

  journalId String?
  status    BankDocumentStatus @default(POSTED)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bankAccount  LedgerAccount @relation("DepositBankAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)
  journal      Journal?      @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines        DepositLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, deletedAt])
  @@map("deposits")
}

/// One item on a paying-in slip.
///
/// Either a customer payment being cleared out of Undeposited Funds, or money
/// from somewhere else entirely — bank interest, a refund, an owner's injection.
/// Exactly one of the two, enforced by a CHECK.
model DepositLine {
  id        String @id @default(cuid())
  depositId String
  orgId     String

  lineNumber Int @db.SmallInt

  /// Set when this line clears a payment out of Undeposited Funds.
  customerPaymentId String?
  /// Set when the money came from somewhere other than a customer payment.
  accountId         String?

  description String?
  amount      Decimal @db.Decimal(19, 4)

  deposit         Deposit          @relation(fields: [depositId], references: [id], onDelete: Cascade)
  customerPayment CustomerPayment? @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)
  account         LedgerAccount?   @relation("DepositLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([depositId, lineNumber])
  @@unique([customerPaymentId])
  @@index([orgId, depositId])
  @@map("deposit_lines")
}

/// A line read from a bank statement, before anyone has decided what it is.
///
/// Kept separate from the ledger on purpose: an imported row is a claim by the
/// bank, not an entry in the books. It becomes an entry only when someone matches
/// it to something already posted, or uses it to create something.
model ImportedTransaction {
  id    String @id @default(cuid())
  orgId String

  accountId String

  date        DateTime @db.Date
  description String
  reference   String?

  /// Signed as the statement reads it: positive money in, negative money out.
  amount Decimal @db.Decimal(19, 4)

  /// The bank's own identifier where the file provides one, used to avoid
  /// importing the same line twice.
  externalId String?

  status ImportedTransactionStatus @default(PENDING)

  matchedJournalLineId String?
  matchedAt            DateTime? @db.Timestamptz(6)

  /// Chosen on the feed before the line is posted. Not a ledger entry.
  categoryAccountId String?
  vendorId          String?
  customerId        String?

  importedAt   DateTime @default(now()) @db.Timestamptz(6)
  importedById String?

  organization       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account            LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryAccount    LedgerAccount?  @relation("ImportCategory", fields: [categoryAccountId], references: [id], onDelete: SetNull)
  vendor             Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  matchedJournalLine JournalLine?    @relation(fields: [matchedJournalLineId], references: [id], onDelete: SetNull)
  files              LedgerFile[]

  @@unique([orgId, accountId, externalId])
  @@index([orgId, accountId, status, date])
  @@map("imported_transactions")
}

/// One reconciliation of one account against one statement.
model BankReconciliation {
  id    String @id @default(cuid())
  orgId String

  accountId String

  statementDate           DateTime @db.Date
  /// What the statement says the account held on that date.
  statementEndingBalance  Decimal  @db.Decimal(19, 4)
  /// The total of everything reconciled before this one. Recorded rather than
  /// recomputed, so a finished reconciliation reads the same for ever.
  beginningBalance        Decimal  @db.Decimal(19, 4)

  status ReconciliationStatus @default(IN_PROGRESS)

  notes String?

  startedAt     DateTime  @default(now()) @db.Timestamptz(6)
  startedById   String?
  completedAt   DateTime? @db.Timestamptz(6)
  completedById String?

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      LedgerAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries      ReconciliationEntry[]

  @@index([orgId, accountId, statementDate(sort: Desc)])
  @@map("bank_reconciliations")
}

/// One journal line marked as cleared by one reconciliation.
///
/// This table exists because a posted journal line is immutable (R4). Setting a
/// `cleared` flag on the line would be a change to it, and the trigger would
/// refuse — rightly. Recording the fact beside the line instead keeps the ledger
/// append-only and, as a bonus, keeps the full history of which reconciliation
/// cleared what.
model ReconciliationEntry {
  id    String @id @default(cuid())
  orgId String

  reconciliationId String
  journalLineId    String

  clearedAt DateTime @default(now()) @db.Timestamptz(6)

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  journalLine    JournalLine        @relation(fields: [journalLineId], references: [id], onDelete: Restrict)

  /// A line can be cleared by at most one reconciliation.
  @@unique([journalLineId])
  @@index([orgId, reconciliationId])
  @@map("reconciliation_entries")
}

// ---------------------------------------------------------------------------
// Inventory  (Phase 7)
// ---------------------------------------------------------------------------

/// Every movement of stock, and what it did to the average cost.
///
/// This is a ledger in its own right, and it obeys the same discipline as the
/// general ledger: append-only, one row per event, running totals carried on the
/// row rather than recomputed. Its total value must always equal the Inventory
/// Asset balance in the general ledger — because every movement posts exactly its
/// own `value` there, in the same transaction that writes this row.
model InventoryTransaction {
  id     String @id @default(cuid())
  orgId  String
  itemId String

  date DateTime              @db.Date
  type InventoryMovementType

  /// What caused it, so a movement can be traced back to its document.
  sourceType   JournalSourceType
  sourceId     String?
  sourceLineId String?

  /// Signed: positive received, negative issued.
  quantity Decimal @db.Decimal(19, 4)

  /// Cost per unit for this movement. On a receipt, what was paid. On an issue,
  /// the weighted average at the moment it was issued. Six decimals because a
  /// per-unit cost divides badly and rounding it early moves the total.
  unitCost Decimal @db.Decimal(19, 6)

  /// Signed value change, and what is posted to the Inventory Asset account.
  value Decimal @db.Decimal(19, 4)

  /// The item's position after this movement.
  runningQuantity Decimal @db.Decimal(19, 4)
  runningValue    Decimal @db.Decimal(19, 4)

  /// Monotonic per item, in the order movements were recorded. See
  /// docs/phases/phase-07-inventory.md on why entry order rather than date order.
  sequence Int

  journalId String?

  /// Which store this quantity belongs to. Null is counted at the office.
  storeId String?

  /// Phase 24: lot (batch) and/or serial for tracked items.
  lotNumber    String?
  serialNumber String?

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdById String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  journal      Journal?     @relation(fields: [journalId], references: [id], onDelete: Restrict)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([itemId, sequence])
  @@index([orgId, itemId, sequence(sort: Desc)])
  @@index([orgId, itemId, storeId])
  @@index([orgId, itemId, lotNumber])
  @@index([orgId, itemId, serialNumber])
  @@index([orgId, date])
  @@index([orgId, sourceType, sourceId])
  @@map("inventory_transactions")
}

/// A count, a write-off, or a revaluation.
model InventoryAdjustment {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  /// Where the difference goes — normally Inventory Shrinkage.
  accountId String

  memo   String?
  reason String?

  /// Which store this count applies to. Null on older adjustments, counted at the office.
  storeId String?

  status BankDocumentStatus @default(POSTED)

  journalId String?

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      LedgerAccount             @relation("AdjustmentAccount", fields: [accountId], references: [id], onDelete: Restrict)
  journal      Journal?                  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  store        Store?                    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  lines        InventoryAdjustmentLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, deletedAt])
  @@index([orgId, storeId])

  @@map("inventory_adjustments")
}

model InventoryAdjustmentLine {
  id           String @id @default(cuid())
  adjustmentId String
  orgId        String

  lineNumber Int @db.SmallInt
  itemId     String

  /// What the count says is actually there.
  countedQuantity Decimal @db.Decimal(19, 4)
  /// What the books said before the adjustment, kept so the document can be read
  /// years later without recomputing history.
  previousQuantity Decimal @db.Decimal(19, 4)
  /// countedQuantity - previousQuantity.
  quantityChange Decimal @db.Decimal(19, 4)

  unitCost Decimal @db.Decimal(19, 6)
  value    Decimal @db.Decimal(19, 4)

  description String?

  adjustment InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item       Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, lineNumber])
  @@index([orgId, itemId])
  @@map("inventory_adjustment_lines")
}

/// Build finished goods from an Inventory Assembly bill of materials.
///
/// Components leave stock at average cost; the assembly arrives at the sum of
/// those costs so a later sale posts the right COGS.
model AssemblyBuild {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  itemId  String
  storeId String?
  /// How many finished units were produced.
  quantity Decimal @db.Decimal(19, 4)
  /// Cost of one finished unit (materials total ÷ quantity).
  unitCost Decimal @db.Decimal(19, 6)
  /// Total materials value moved into the assembly.
  value Decimal @db.Decimal(19, 4)

  memo String?

  status BankDocumentStatus @default(POSTED)

  journalId String?

  /// Phase 28: work order this build completed.
  workOrderId String? @unique

  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item         Item               @relation("AssemblyBuildItem", fields: [itemId], references: [id], onDelete: Restrict)
  store        Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  journal      Journal?           @relation(fields: [journalId], references: [id], onDelete: Restrict)
  workOrder    WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  lines        AssemblyBuildLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, deletedAt])
  @@index([orgId, itemId])
  @@map("assembly_builds")
}

/// Phase 28: planned assembly build. Completing posts via AssemblyBuild.
model WorkOrder {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date
  dueDate DateTime? @db.Date

  itemId  String
  storeId String?
  quantity Decimal @db.Decimal(19, 4)
  memo    String?

  status WorkOrderStatus @default(DRAFT)

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item         Item         @relation("WorkOrderItem", fields: [itemId], references: [id], onDelete: Restrict)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  build        AssemblyBuild?
  lines        WorkOrderLine[]

  @@unique([orgId, number])
  @@index([orgId, status, date(sort: Desc)])
  @@index([orgId, itemId])
  @@map("work_orders")
}

/// Planned component needs snapped from the BOM when the work order is created.
model WorkOrderLine {
  id          String @id @default(cuid())
  workOrderId String
  orgId       String

  lineNumber Int @db.SmallInt
  itemId     String
  /// Total quantity needed for the work order (BOM qty × build qty).
  quantity   Decimal @db.Decimal(19, 4)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  item      Item      @relation("WorkOrderLineItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([workOrderId, lineNumber])
  @@index([orgId, itemId])
  @@map("work_order_lines")
}

model AssemblyBuildLine {
  id      String @id @default(cuid())
  buildId String
  orgId   String

  lineNumber Int @db.SmallInt
  itemId     String

  /// BOM quantity per finished unit × build quantity.
  quantity Decimal @db.Decimal(19, 4)
  unitCost Decimal @db.Decimal(19, 6)
  value    Decimal @db.Decimal(19, 4)

  build AssemblyBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  item  Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([buildId, lineNumber])
  @@index([orgId, itemId])
  @@map("assembly_build_lines")
}

/// Stock moved from one store to another. Quantity and value leave one store
/// and arrive at the other; the item's global average cost does not change.
model StoreTransfer {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  fromStoreId String
  toStoreId   String
  itemId      String

  quantity Decimal @db.Decimal(19, 4)
  unitCost Decimal @db.Decimal(19, 6)
  value    Decimal @db.Decimal(19, 4)

  memo String?

  status    BankDocumentStatus @default(POSTED)
  journalId String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fromStore    Store        @relation("TransferFrom", fields: [fromStoreId], references: [id], onDelete: Restrict)
  toStore      Store        @relation("TransferTo", fields: [toStoreId], references: [id], onDelete: Restrict)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  journal      Journal?     @relation(fields: [journalId], references: [id], onDelete: Restrict)
  ticket       StoreTicket?

  @@unique([orgId, number])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, fromStoreId])
  @@index([orgId, toStoreId])
  @@index([orgId, itemId])
  @@map("store_transfers")
}

/// Ticket for stock taken from a store. Auto-made on transfer or sale, or entered by hand.
model StoreTicket {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  /// Store the goods left.
  storeId String
  /// Store that received them (when this ticket moved stock between stores).
  toStoreId String?
  itemId    String

  quantity Decimal @db.Decimal(19, 4)
  unitCost Decimal @db.Decimal(19, 6)
  value    Decimal @db.Decimal(19, 4)

  /// Who took the goods (name), when known.
  takenBy String?
  memo    String?

  /// AUTO = transfer. MANUAL = ticket form. SALE = issued with an invoice/receipt.
  origin String @default("AUTO")

  transferId String? @unique

  /// Sale that caused this ticket (invoice or sales receipt).
  salesDocumentId     String?
  salesDocumentLineId String?
  /// Delivery note that lists this ticket's item for the customer/carrier.
  deliveryNoteId      String?

  status BankDocumentStatus @default(POSTED)

  /// When the store keeper marked goods prepared / handed to the customer.
  preparedAt   DateTime? @db.Timestamptz(6)
  preparedById String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  toStore      Store?         @relation("TicketToStore", fields: [toStoreId], references: [id], onDelete: Restrict)
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  transfer     StoreTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  salesDocument SalesDocument? @relation(fields: [salesDocumentId], references: [id], onDelete: SetNull)
  deliveryNote  DeliveryNote?  @relation(fields: [deliveryNoteId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, storeId])
  @@index([orgId, storeId, preparedAt])
  @@index([orgId, itemId])
  @@index([orgId, salesDocumentId])
  @@index([orgId, deliveryNoteId])
  @@map("store_tickets")
}

/// Customer delivery note (packing / dispatch advice) for goods leaving on a sale.
///
/// Created automatically when an invoice or sales receipt posts stock out. One
/// note per sale document; the carrier and the customer can print it. It is not
/// a ledger document — the invoice/receipt already posted the books.
model DeliveryNote {
  id    String @id @default(cuid())
  orgId String

  number String
  /// Business date of the sale (same calendar day as the invoice/receipt).
  date   DateTime @db.Date
  /// Clock time the note was issued (dispatch / loading time).
  issuedAt DateTime @default(now()) @db.Timestamptz(6)

  customerId      String
  salesDocumentId String

  /// Primary store the goods left from, when every line shares one.
  storeId String?

  /// Free text for the carrier, vehicle, or loading bay.
  carrier String?
  /// Instructions or remarks printed on the note.
  notes   String?

  status BankDocumentStatus @default(POSTED)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization  Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesDocument SalesDocument      @relation(fields: [salesDocumentId], references: [id], onDelete: Restrict)
  store         Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  lines         DeliveryNoteLine[]
  tickets       StoreTicket[]

  @@unique([orgId, number])
  @@unique([orgId, salesDocumentId])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, customerId, date(sort: Desc)])
  @@index([orgId, status])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id             String @id @default(cuid())
  deliveryNoteId String
  orgId          String

  lineNumber Int @db.SmallInt

  itemId      String?
  description String?
  quantity    Decimal @db.Decimal(19, 4)
  storeId     String?

  /// Line on the invoice/receipt this packing line came from.
  salesDocumentLineId String?

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  item         Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([deliveryNoteId, lineNumber])
  @@index([orgId, deliveryNoteId])
  @@map("delivery_note_lines")
}

// ---------------------------------------------------------------------------
// Workspace, bank rules, report notes, and papers on a transaction
// ---------------------------------------------------------------------------

/// A meeting, appointment, or reminder on the organisation calendar (Odoo-style).
model CalendarEvent {
  id    String @id @default(cuid())
  orgId String

  title       String
  description String?
  location    String?
  /// meeting | appointment | reminder
  kind        String  @default("meeting")

  startsAt DateTime @db.Timestamptz(6)
  endsAt   DateTime @db.Timestamptz(6)
  allDay   Boolean  @default(false)

  /// Minutes before start when the shell reminder appears. Null = no reminder.
  reminderMinutes     Int?
  /// Set when someone dismisses the reminder from the shell.
  reminderDismissedAt DateTime? @db.Timestamptz(6)

  createdById String
  customerId  String?
  vendorId    String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([orgId, startsAt])
  @@index([orgId, endsAt])
  @@index([orgId, reminderDismissedAt, startsAt])
  @@map("calendar_events")
}

/// A saved link (shortcut) or a pinned app, for one person in one organisation.
model WorkspaceBookmark {
  id     String @id @default(cuid())
  orgId  String
  userId String

  label String
  href  String
  /// `shortcut` is a page they bookmarked. `pin` is an app they want on Home.
  kind  String
  sort  Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, href, kind])
  @@index([orgId, userId, kind, sort])
  @@map("workspace_bookmarks")
}

/// Personal / team checklist (Odoo To-do). Not a project board task — see ProjectTask.
model WorkspaceTodo {
  id    String @id @default(cuid())
  orgId String

  /// Who created / owns the row (always set).
  userId String
  /// Optional colleague who should do it (same org).
  assigneeId String?

  title   String
  notes   String?
  dueDate DateTime? @db.Date
  /// Odoo-style priority: 0 normal, 1 important, 2 urgent.
  priority Int @default(0)
  /// Open → In progress → Waiting → Done.
  stage WorkspaceTodoStage @default(OPEN)
  /// Set when stage = DONE (kept for overdue / list filters).
  doneAt DateTime? @db.Timestamptz(6)
  /// How it was closed (required when moving to DONE).
  completionKind WorkspaceTodoCompletion?
  /// Note / report text from the person closing the work.
  completionNote String?
  completedById  String?
  /// Order among open items for the owner (lower = higher).
  sequence Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User         @relation("WorkspaceTodoOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("WorkspaceTodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy  User?        @relation("WorkspaceTodoCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([orgId, userId, doneAt, sequence])
  @@index([orgId, assigneeId, doneAt])
  @@index([orgId, stage, sequence])
  @@map("workspace_todos")
}

/// Folder in the company file library (Odoo Documents-style workspace).
model WorkspaceDocumentFolder {
  id    String @id @default(cuid())
  orgId String

  name String
  /// Stable key for seeded folders (`contracts`, `finance`, …). Null = user-created.
  systemKey String?
  /// Seeded folders cannot be deleted.
  isSystem  Boolean @default(false)
  sequence  Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents    WorkspaceDocument[]

  @@unique([orgId, name])
  @@unique([orgId, systemKey])
  @@index([orgId, sequence])
  @@map("workspace_document_folders")
}

/// Company file library (Odoo Documents-style). Not a sales/purchase document.
model WorkspaceDocument {
  id    String @id @default(cuid())
  orgId String

  folderId String?

  /// Display name; defaults to the original file name.
  title        String
  originalName String
  contentType  String
  byteSize     Int
  /// Path under the documents/ object-store prefix. Never a public URL.
  storageKey   String
  notes        String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder       WorkspaceDocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy    User?                    @relation("WorkspaceDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, folderId, createdAt])
  @@index([orgId, title])
  @@map("workspace_documents")
}

/// Internal wiki page (Odoo Knowledge-style). Not a sales/purchase document.
model KnowledgeArticle {
  id    String @id @default(cuid())
  orgId String

  title String
  /// HTML body (TipTap). Plain text from early rows still renders as text.
  body  String @db.Text

  /// Workspace = company; Shared = invited; Private = owner only.
  scope KnowledgeScope @default(WORKSPACE)
  /// Nesting — child inherits the parent's scope on create.
  parentId String?
  /// Owner of PRIVATE / SHARED articles; null for workspace pages.
  ownerId String?
  /// Order among siblings (lower first).
  sequence Int @default(0)

  /// Title emoji (Odoo-style).
  icon     String?
  /// Cover image URL (paste/upload URL — not Unsplash).
  coverUrl String?

  lockedAt   DateTime? @db.Timestamptz(6)
  lockedById String?
  /// Soft trash (Odoo “Send to Trash”).
  deletedAt  DateTime? @db.Timestamptz(6)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       KnowledgeArticle?  @relation("KnowledgeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     KnowledgeArticle[] @relation("KnowledgeTree")
  owner        User? @relation("KnowledgeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  lockedBy     User? @relation("KnowledgeLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  createdBy    User? @relation("KnowledgeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User? @relation("KnowledgeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  favorites    KnowledgeFavorite[]
  shares       KnowledgeShare[]
  revisions    KnowledgeRevision[]

  @@index([orgId, scope, parentId, sequence])
  @@index([orgId, updatedAt])
  @@index([orgId, title])
  @@index([orgId, ownerId, scope])
  @@index([orgId, deletedAt])
  @@map("knowledge_articles")
}

/// Per-user star (Odoo Favorites).
model KnowledgeFavorite {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  articleId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([orgId, userId])
  @@map("knowledge_favorites")
}

/// Invited members on a SHARED article (Odoo Share → Invite).
model KnowledgeShare {
  id        String   @id @default(cuid())
  orgId     String
  articleId String
  userId    String
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([orgId, userId])
  @@map("knowledge_shares")
}

/// Snapshot before each save (Odoo version history). Cap enforced in service.
model KnowledgeRevision {
  id        String   @id @default(cuid())
  orgId     String
  articleId String
  title     String
  body      String   @db.Text
  createdById String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("KnowledgeRevisionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([orgId, articleId])
  @@map("knowledge_revisions")
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
  INTERN
}

enum WageType {
  MONTHLY
  DAILY
  HOURLY
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REFUSED
  CANCELLED
}

enum AttendanceSource {
  MANUAL
  DEVICE
}

enum AttendanceDeviceKind {
  GENERIC_HTTP
  ZKTECO
  ANVIZ
  OTHER
}

enum AttendancePunchKind {
  IN
  OUT
  UNKNOWN
}

enum PayrollRunStatus {
  DRAFT
  POSTED
}

enum PayMethod {
  CASH
  BANK
  MOBILE
}

enum PayrollPayMode {
  IMMEDIATE
  ACCRUE
}

enum SalaryCalc {
  BASE
  FIXED
  PERCENT
  /// Progressive brackets on basic: [{ upTo, rate }, …] stored in SalaryRule.slabs.
  SLABS
}

enum SalaryRuleKind {
  EARNING
  DEDUCTION
  EMPLOYER
}

enum AdvanceKind {
  LOAN
  ADVANCE
}

enum PayslipLineKind {
  EARNING
  DEDUCTION
}

enum EmployeeContractState {
  DRAFT
  OPEN
  EXPIRED
  CANCELLED
}

enum EmployeeDocumentKind {
  CONTRACT
  ID
  CERTIFICATE
  OTHER
}

enum EmployeeLifecycleStatus {
  DRAFT
  ACTIVE
  LEFT
}

/// Company people directory (Odoo Employees-style). Not login/access — that is Membership.
model Employee {
  id    String @id @default(cuid())
  orgId String

  name       String
  jobTitle   String?
  department String?
  /// Photo URL (paste link — same pattern as Knowledge cover).
  photoUrl   String?

  workEmail String?
  workPhone String?
  mobile    String?

  workStreet  String?
  workCity    String?
  workCountry String?

  privateStreet  String?
  privateCity    String?
  privateCountry String?

  emergencyContact String?
  emergencyPhone   String?

  /// Comma-separated skills / tags (Odoo skills lite).
  skills String?

  notes  String?
  active Boolean @default(true)
  /// Payroll and planning use ACTIVE only; LEFT cannot be added to new runs.
  lifecycleStatus EmployeeLifecycleStatus @default(ACTIVE)

  employmentType EmploymentType @default(EMPLOYEE)
  hiredAt        DateTime?      @db.Date
  leftAt         DateTime?      @db.Date

  /// Reports-to (org chart).
  managerId String?

  /// Optional link to a login user on this company (one employee card per user).
  userId String?

  wageType          WageType @default(MONTHLY)
  wageAmount        Decimal  @default(0) @db.Decimal(19, 4)
  expenseAccountId  String?
  payableAccountId  String?
  /// Where this person's net pay is credited when the run pays immediately.
  payMethod         PayMethod @default(CASH)
  payAccountId      String?
  /// Optional salary structure. Empty means the card wage alone.
  structureId       String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  manager        Employee?     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports        Employee[]    @relation("EmployeeManager")
  expenseAccount LedgerAccount? @relation("EmployeeWageExpense", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  payableAccount LedgerAccount? @relation("EmployeeWagePayable", fields: [payableAccountId], references: [id], onDelete: Restrict)
  payAccount     LedgerAccount? @relation("EmployeePayAccount", fields: [payAccountId], references: [id], onDelete: Restrict)
  structure      SalaryStructure? @relation(fields: [structureId], references: [id], onDelete: SetNull)

  leaveAllocations LeaveAllocation[]
  leaveRequests    LeaveRequest[]
  attendanceDays   AttendanceDay[]
  payslips         Payslip[]
  advances         EmployeeAdvance[]
  endOfService     EndOfService[]
  contracts        EmployeeContract[]
  documents        EmployeeDocument[]
  deviceUsers      AttendanceDeviceUser[]
  punches          AttendancePunch[]
  applicants       Applicant[]
  appraisals       Appraisal[]
  planningAssignments PlanningAssignment[]
  trainingEnrollments TrainingEnrollment[]

  @@unique([orgId, userId])
  @@index([orgId, active])
  @@index([orgId, lifecycleStatus])
  @@index([orgId, name])
  @@index([orgId, managerId])
  @@index([orgId, department])
  @@map("employees")
}

/// Employment contract (Odoo hr.contract lite). Wage here can sync onto the employee card.
model EmployeeContract {

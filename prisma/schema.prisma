  AP_CLERK
  /// Bank deposits, transfers and imports.
  BANK_CLERK
  /// POS till lead — configure counters.
  POS_SUPERVISOR
  /// POS till and customer receipts.
  CASHIER
  /// Stock lead — items and inventory approvals.
  WAREHOUSE_MANAGER
  STORE_KEEPER

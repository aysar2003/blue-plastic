model Organization {
  id       String @id @default(cuid())
  name     String
  legalName String?

  /// ISO 4217. The ledger's reporting currency. Immutable once any journal exists
  /// (guarded in the service layer, and by Phase 2's posting engine).
  baseCurrency String @default("USD") @db.Char(3)

  /// 1 = January. A fiscal year starting in month M runs M..M+11.
  fiscalYearStartMonth Int @default(1) @db.SmallInt

  taxRegistrationNumber String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String? @db.Char(2)

  phone   String?
  email   String?
  website String?

  /// IANA zone used to resolve "today" for date defaults and period boundaries.
  timeZone String @default("UTC")

  /// Whether stock may be sold before it has been received.
  ///
  /// On by default so a till or invoice can sell ahead of a later bill — the
  /// store goes below zero and a receipt fills it. Turn off only when the
  /// business must refuse sales that would leave a shelf short.
  allowNegativeStock Boolean @default(true)

  /// How POS till money appears on the chart of accounts.
  /// HOLD_OFF_CHART = till holds sales until transfer; till banks stay off the chart.
  /// REGISTER_IN_CHART = each till is a POS Banks sub-account (default).
  posTillLedgerMode PosTillLedgerMode @default(REGISTER_IN_CHART)

  /// Odoo-style Configuration switches: which deletes are offered, which apps are on.
  /// Shape: `lib/feature-flags.ts` (`OrgFeatureFlags`). Null means defaults (all on).
  featureFlags Json?

  /// Industry / institution pack id from `lib/packs` (e.g. retail, hospital_admin).
  /// Null = no pack installed yet. Vertical deepen may still be planned for some ids.
  installedPackId String?

  /// When set, the institution onboarding wizard was finished or skipped.
  onboardingCompletedAt DateTime? @db.Timestamptz(6)

  /// Pack checklist item ids the company marked done. Shape: `string[]`.
  onboardingChecklistDone Json?

  /// How invoices and statements are drawn. Shape: `lib/document-template.ts`.
  /// Null means the merchant paper (teal bill) with the classic sheet hidden.
  documentTemplate Json?

  /// Company form layouts: which fields/columns show on sales and purchase entry.
  /// Shape: `lib/form-templates.ts` (`OrgFormTemplates`). Null → system defaults.
  formTemplates Json?

  /// Short mark shown in the shell when no logo is set (e.g. "AF"). Null → initials from name.
  brandMark String?

  /// Relative path under uploads/branding for the company logo image.
  logoStorageKey String?
  logoContentType String?

  /// Main company this database belongs to. Null = standalone or a main (holding) company.
  /// One level only — a sub-company cannot have children. Cap is enforced in the service layer.
  parentOrgId String?
  parent      Organization?  @relation("OrgGroup", fields: [parentOrgId], references: [id], onDelete: Restrict)
  children    Organization[] @relation("OrgGroup")
  /// Parent ownership of this company (0–100). Used only when parentOrgId is set. Default 100 = wholly owned.
  ownershipPercent Decimal @default(100) @db.Decimal(7, 4)

  /// When true, only the system owner may open this company (locked / restricted).
  accessRestricted Boolean @default(false)

  /// Rent / subscription end. After this moment staff cannot open the books (system owner still can).
  rentExpiresAt DateTime? @db.Timestamptz(6)

  /// Max ACTIVE memberships (users) for this company. Null = unlimited.
  maxUsers Int?

  /// Free note for the rent / restriction (e.g. invoice ref, plan name).
  rentNote String?

  /// Outbound SMTP for invoices / bills / statements (per company).
  /// Password is sealed with AUTH_SECRET — see `lib/sealed-secret.ts`.
  smtpHost            String?
  smtpPort            Int?     @db.SmallInt
  smtpSecure          Boolean  @default(true)
  smtpUser            String?
  smtpFrom            String?
  smtpPasswordSealed  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships    Membership[]
  auditLogs      AuditLog[]
  sequences      DocumentSequence[]

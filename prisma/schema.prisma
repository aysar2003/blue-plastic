/// One row per org — hours/day, OT rules for payroll.
model HrSettings {
  id    String @id @default(cuid())
  orgId String @unique

  hoursPerDay              Decimal @default(8) @db.Decimal(19, 4)
  workDaysPerWeek          Int     @default(6)
  overtimeAfterHoursPerDay Decimal @default(8) @db.Decimal(19, 4)
  overtimeMultiplier       Decimal @default(1.5) @db.Decimal(19, 4)
  /// Extra OT bands after the first: [{ "afterHours": "12", "multiplier": "2" }, …].
  overtimeRules Json?
  /// Weekdays that count as work (0=Sun … 6=Sat). Null → derived from workDaysPerWeek.
  workWeekdays Json?
  /// Free-text note (e.g. Africa/Mogadishu) — display only.
  timezoneNote String?

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("hr_settings")

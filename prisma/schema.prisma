// Blue Plastic Center — accounting system
//
// Phase 1: organisation, identity, auditing, document numbering.
// Phase 2: the ledger — chart of accounts, fiscal periods, journals and lines.
// Phase 3: master data — customers, vendors, items, tax and payment terms.
// Phase 4: sales — invoices, estimates, receipts, credit memos, payments.
// Phase 5: purchases — bills, expenses, vendor credits, purchase orders.
// Phase 6: banking — transfers, deposits, statement import, reconciliation.
// Phase 7: inventory — stock movements, weighted-average cost, COGS.
//
// The integrity rules that make this a real double-entry ledger (R1–R10 in
// docs/02-accounting-design.md) are enforced by database triggers, which Prisma
// cannot model. They live in prisma/sql/ and are applied by migrations;
// `pnpm db:verify` asserts they are still present in the connected database.

generator client {
  provider      = "prisma-client-js"
  /// Native for local/dev; Vercel serverless is Amazon Linux (OpenSSL 3).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Prisma 7 moved connection URLs out of the schema: migrations read them from
// `prisma.config.ts`, and the client receives a driver adapter (see server/db.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  BOOKKEEPER
  SALES
  STORE_KEEPER
  VIEWER
  /// Access comes from Membership.permissionsOverride, not a role template.
  CUSTOM
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  POST
  REVERSE
  CLOSE_PERIOD
  REOPEN_PERIOD
}

/// Document families that draw from a numbering sequence. Values beyond JOURNAL
/// are unused until their phase lands, but are declared now so the enum is not
/// migrated on every subsequent phase.
enum DocumentType {
  JOURNAL
  INVOICE
  ESTIMATE
  /// Formal sales quotation — same non-posting shape as an estimate, own number series.
  QUOTATION
  SALES_RECEIPT
  CREDIT_MEMO
  CUSTOMER_PAYMENT
  REFUND_RECEIPT
  BILL
  BILL_PAYMENT
  EXPENSE
  VENDOR_CREDIT
  PURCHASE_ORDER
  TRANSFER
  DEPOSIT
  INVENTORY_ADJUSTMENT
  /// Stock moved from one store to another.
  STORE_TRANSFER
  /// Ticket for stock taken out of a store (manual or automatic).
  STORE_TICKET
  /// Customer delivery / packing note for goods leaving on a sale.
  DELIVERY_NOTE
}

/// Statement classification. Determines which financial statement an account
/// appears on and its normal balance.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/// Detail classification. Drives report grouping and app behaviour (a BANK
/// account gets a register; an ACCOUNTS_RECEIVABLE account is a control account).
enum AccountSubtype {
  // ASSET
  BANK
  ACCOUNTS_RECEIVABLE
  UNDEPOSITED_FUNDS
  INVENTORY
  OTHER_CURRENT_ASSET
  FIXED_ASSET
  ACCUMULATED_DEPRECIATION
  OTHER_ASSET

  // LIABILITY
  ACCOUNTS_PAYABLE
  CREDIT_CARD
  SALES_TAX_PAYABLE
  OTHER_CURRENT_LIABILITY
  LONG_TERM_LIABILITY

  // EQUITY
  OWNERS_EQUITY
  RETAINED_EARNINGS
  OPENING_BALANCE_EQUITY
  DRAWINGS

  // REVENUE
  INCOME
  OTHER_INCOME
  SALES_DISCOUNTS

  // EXPENSE
  COST_OF_GOODS_SOLD
  OPERATING_EXPENSE
  OTHER_EXPENSE
  DEPRECIATION
}

/// Roles the engine posts to, rather than accounts it names. Seeded once per
/// organisation and never deleted, but the account a role points at can be
/// changed in Settings -> Default accounts: a business with its own chart should
/// be able to say "our receivables account is 1150" rather than be told what to
/// call things. Moving a role does not move a balance.
enum SystemAccountKey {
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  UNDEPOSITED_FUNDS
  INVENTORY_ASSET
  COGS
  SALES_TAX_PAYABLE
  RETAINED_EARNINGS
  OPENING_BALANCE_EQUITY
  EXCHANGE_GAIN_LOSS
  ROUNDING_DIFFERENCE
  INVENTORY_SHRINKAGE
  UNCATEGORISED_INCOME
  UNCATEGORISED_EXPENSE
}

/// How an item behaves. The distinction drives which accounts it must map to and
/// whether selling it moves stock.
enum ItemType {
  /// Labour and services. Income account only.
  SERVICE
  /// Goods bought and resold without tracking stock levels.
  NON_INVENTORY
  /// Goods with tracked quantity and cost. Selling one moves inventory and COGS.
  INVENTORY
}

/// How a payment term computes a due date.
enum PaymentTermType {
  /// Due immediately.
  DUE_ON_RECEIPT
  /// Due a fixed number of days after the document date.
  NET_DAYS
  /// Due on a fixed day of the following month.
  DAY_OF_MONTH
}

/// Whether a tax rate applies to what is sold, what is bought, or both.
enum TaxApplication {
  SALES
  PURCHASES
  BOTH
}

enum TaxFilingFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

/// One table holds every customer-facing document, discriminated by type.
///
/// They share a shape — a customer, a date, lines, tax, a total — and separating
/// them into near-identical tables would mean copies of the totalling logic and
/// a union every time anyone asks what a customer has been sent. Estimates and
/// quotations are the odd ones out: proposals, not transactions, and they post
/// no journal. They stay as separate types so each has its own list, form, and
/// number series.
enum SalesDocumentType {
  INVOICE
  ESTIMATE
  QUOTATION
  SALES_RECEIPT
  CREDIT_MEMO
  REFUND_RECEIPT
}

enum SalesDocumentStatus {
  /// Not yet posted. Editable freely; invisible to the ledger.
  DRAFT
  /// Posted and outstanding.
  OPEN
  /// Partly settled by payments or credits.
  PARTIAL
  /// Fully settled.
  PAID
  /// Reversed out of the ledger. Kept, never deleted.
  VOID
  /// Estimates only.
  ACCEPTED
  DECLINED
  /// An estimate that became an invoice, or a credit fully applied.
  CLOSED
}

/// The purchase side mirrors the sales side. A bill is an invoice pointing the
/// other way; a vendor credit is a credit memo; an expense is a sales receipt.
/// Keeping the shapes parallel keeps the two subledgers behaving identically,
/// which is what an accountant expects of them.
enum PurchaseDocumentType {
  BILL
  /// Bought and paid at once. Never becomes a payable.
  EXPENSE
  VENDOR_CREDIT
  /// An order placed. Nothing has happened yet, so nothing is posted.
  PURCHASE_ORDER
}

enum PurchaseDocumentStatus {
  DRAFT
  OPEN
  PARTIAL
  PAID
  VOID
  /// A purchase order that became a bill, or a credit fully applied.
  CLOSED
}

/// Why stock moved. Every movement has one, and it decides which journal the
/// movement belongs to.
enum InventoryMovementType {
  /// Received on a bill.
  PURCHASE
  /// Issued on an invoice or sales receipt.
  SALE
  /// Came back on a credit memo.
  SALE_RETURN
  /// Sent back to the vendor on a vendor credit.
  PURCHASE_RETURN
  /// A count, a write-off, or a revaluation.
  ADJUSTMENT
  /// Stock the business already had when the books started.
  OPENING
  /// Moved from one store to another. Global quantity and value do not change.
  TRANSFER
}

enum BankDocumentStatus {
  POSTED
  VOID
}

/// Where an imported statement line has got to.
enum ImportedTransactionStatus {
  /// Read from the file, not yet dealt with.
  PENDING
  /// Tied to a journal line that was already in the books.
  MATCHED
  /// Deliberately set aside — a duplicate, or something already entered by hand.
  EXCLUDED
}

enum ReconciliationStatus {
  IN_PROGRESS
  /// Finished and balanced. Its lines are locked.
  COMPLETED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  MOBILE_MONEY
  OTHER
}

enum PeriodStatus {
  /// Postings allowed.
  OPEN
  /// Soft close. Postings rejected; a user with `period:reopen` can reopen it.
  CLOSED
  /// Hard close, after the year-end closing entry.
  LOCKED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
  /// Soft-deleted along with the transaction that produced it.
  ///
  /// The row stays. Nothing about the entry is changed and nothing is removed
  /// from the database, so the history of what was once posted survives — but
  /// every balance, statement, register and report excludes it, so it can no
  /// longer affect a figure anybody reads. The one status the immutability
  /// trigger accepts besides REVERSED, and only alongside the deletion stamp.
  DELETED
}

/// What kind of business transaction produced this journal. Values beyond the
/// first four belong to later phases and are declared now so the enum is not
/// migrated on every subsequent phase.
enum PosSessionStatus {
  OPEN
  CLOSED
}

enum PosCashMoveKind {
  IN
  OUT
}

enum JournalSourceType {
  MANUAL
  OPENING_BALANCE
  CLOSING_ENTRY
  REVERSAL
  INVOICE
  SALES_RECEIPT
  CUSTOMER_PAYMENT
  CREDIT_MEMO
  REFUND_RECEIPT
  BILL
  BILL_PAYMENT
  EXPENSE
  VENDOR_CREDIT
  TRANSFER
  DEPOSIT
  INVENTORY_ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id       String @id @default(cuid())
  name     String
  legalName String?

  /// ISO 4217. The ledger's reporting currency. Immutable once any journal exists
  /// (guarded in the service layer, and by Phase 2's posting engine).
  baseCurrency String @default("USD") @db.Char(3)

  /// 1 = January. A fiscal year starting in month M runs M..M+11.
  fiscalYearStartMonth Int @default(1) @db.SmallInt

  taxRegistrationNumber String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String? @db.Char(2)

  phone   String?
  email   String?
  website String?

  /// IANA zone used to resolve "today" for date defaults and period boundaries.
  timeZone String @default("UTC")

  /// Whether stock may be sold before it has been received.
  ///
  /// On by default so a till or invoice can sell ahead of a later bill — the
  /// store goes below zero and a receipt fills it. Turn off only when the
  /// business must refuse sales that would leave a shelf short.
  allowNegativeStock Boolean @default(true)

  /// Odoo-style Configuration switches: which deletes are offered, which apps are on.
  /// Shape: `lib/feature-flags.ts` (`OrgFeatureFlags`). Null means defaults (all on).
  featureFlags Json?

  /// How invoices and statements are drawn. Shape: `lib/document-template.ts`.
  /// Null means the merchant paper (teal bill) with the classic sheet hidden.
  documentTemplate Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships    Membership[]
  auditLogs      AuditLog[]
  sequences      DocumentSequence[]
  ledgerAccounts LedgerAccount[]
  fiscalYears    FiscalYear[]
  periods        AccountingPeriod[]
  journals       Journal[]
  customers      Customer[]
  vendors        Vendor[]
  salesDocuments     SalesDocument[]
  customerPayments   CustomerPayment[]
  purchaseDocuments  PurchaseDocument[]
  billPayments       BillPayment[]
  bankTransfers      BankTransfer[]
  deposits           Deposit[]
  inventoryMovements InventoryTransaction[]
  inventoryAdjustments InventoryAdjustment[]
  storeTransfers       StoreTransfer[]
  storeTickets         StoreTicket[]
  deliveryNotes        DeliveryNote[]
  importedTransactions ImportedTransaction[]
  reconciliations    BankReconciliation[]
  items          Item[]
  itemCategories ItemCategory[]
  stores         Store[]
  paymentTerms   PaymentTerm[]
  taxAgencies    TaxAgency[]
  taxRates       TaxRate[]
  taxCodes       TaxCode[]
  customerFiles  CustomerFile[]
  bankRules      BankRule[]
  bookmarks      WorkspaceBookmark[]
  reportNotes    ReportNote[]
  ledgerFiles    LedgerFile[]
  posPaymentMethods PosPaymentMethod[]
  posRegisters      PosRegister[]
  posSessions       PosSession[]
  posOrders         PosOrder[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  /// Argon2id/bcrypt hash. Null for users who only ever sign in via an OAuth
  /// provider (none configured yet — see ADR-0007).
  passwordHash  String?
  image         String?
  emailVerified DateTime? @db.Timestamptz(6)

  lastLoginAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  accounts    Account[]
  sessions    Session[]
  auditLogs   AuditLog[]
  bookmarks   WorkspaceBookmark[]
  posRegisters PosRegisterStaff[]

  @@map("users")
}

model Membership {
  id     String @id @default(cuid())
  orgId  String
  userId String

  role   Role             @default(VIEWER)
  status MembershipStatus @default(INVITED)

  /// When non-empty, this list is the member’s exact capability set (role is then
  /// a label / starting template). Empty means use ROLE_PERMISSIONS[role].
  /// Required in practice when role is CUSTOM.
  permissionsOverride String[] @default([])

  /// Incremented on every role or status change. The JWT carries the value it was
  /// issued with; a mismatch invalidates the session on the next request, which
  /// gives JWT sessions revocation semantics (ADR-0007).
  version Int @default(1)

  invitedById String?
  invitedAt   DateTime? @db.Timestamptz(6)
  acceptedAt  DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, status])
  @@map("memberships")
}

// --- NextAuth adapter tables ------------------------------------------------
// Present from the start so adding an OAuth provider later is configuration
// rather than a migration against a live database.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Cross-cutting infrastructure
// ---------------------------------------------------------------------------

model AuditLog {
  id      String @id @default(cuid())
  orgId   String
  actorId String?

  entity   String
  entityId String
  action   AuditAction

  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  at DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, at(sort: Desc)])
  @@index([orgId, entity, entityId])
  @@index([orgId, actorId, at(sort: Desc)])
  @@map("audit_logs")
}

model DocumentSequence {
  id    String @id @default(cuid())
  orgId String

  docType    DocumentType
  prefix     String       @default("")
  nextNumber Int          @default(1)
  padding    Int          @default(5) @db.SmallInt

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, docType])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// The ledger  (Phase 2)
// ---------------------------------------------------------------------------

/// Chart of accounts.
///
/// Named `LedgerAccount` rather than `Account` because NextAuth's adapter already
/// owns that table name, and renaming the adapter's table to free it up would
/// break a convention for no gain.
model LedgerAccount {
  id    String @id @default(cuid())
  orgId String

  /// Account number. Unique per organisation; sorts the chart.
  code        String
  name        String
  description String?

  type    AccountType
  subtype AccountSubtype

  /// Report grouping only. A parent never carries postings of its own.
  parentId String?

  /// Set for the handful of accounts the engine refers to by name.
  systemKey SystemAccountKey?

  /// System accounts cannot be deleted or repurposed. Ordinary accounts can be
  /// archived but never deleted once they carry a posted line.
  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  /// Set on BANK and CREDIT_CARD accounts held in a currency other than the
  /// organisation's base. Unused until multi-currency lands (ADR-0006).
  currencyCode String? @db.Char(3)

  /// A finer label under the subtype, such as "Sales of product income".
  /// The subtype still decides how the books behave; this only names the account
  /// more precisely on the chart and on reports.
  detailType String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       LedgerAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     LedgerAccount[] @relation("AccountHierarchy")
  journalLines JournalLine[]

  // Master data that points at this account (Phase 3). All Restrict: an account
  // an item or a tax rate posts through cannot quietly disappear.
  vendorDefaults    Vendor[]  @relation("VendorDefaultExpense")
  itemsIncome       Item[]    @relation("ItemIncome")
  itemsExpense      Item[]    @relation("ItemExpense")
  itemsInventory    Item[]    @relation("ItemInventory")
  itemsCogs         Item[]    @relation("ItemCogs")
  taxRatesSales     TaxRate[] @relation("TaxRateSales")
  taxRatesPurchase  TaxRate[] @relation("TaxRatePurchase")
  salesLines        SalesDocumentLine[]    @relation("SalesLineIncome")
  salesDeposits     SalesDocument[]        @relation("SalesDepositAccount")
  paymentDeposits   CustomerPayment[]      @relation("PaymentDepositAccount")
  purchaseLines     PurchaseDocumentLine[] @relation("PurchaseLineExpense")
  purchasePayments  PurchaseDocument[]     @relation("PurchasePaymentAccount")
  billPaymentSource BillPayment[]          @relation("BillPaymentAccount")
  adjustments       InventoryAdjustment[]  @relation("AdjustmentAccount")
  stores            Store[]                @relation("StoreAccount")
  transfersFrom     BankTransfer[]         @relation("TransferFrom")
  transfersTo       BankTransfer[]         @relation("TransferTo")
  deposits          Deposit[]              @relation("DepositBankAccount")
  depositLines      DepositLine[]          @relation("DepositLineAccount")
  importedLines     ImportedTransaction[]
  importCategories  ImportedTransaction[] @relation("ImportCategory")
  reconciliations   BankReconciliation[]
  rulesForBank      BankRule[]            @relation("RuleBank")
  rulesForCategory  BankRule[]            @relation("RuleCategory")
  posPaymentMethods PosPaymentMethod[]    @relation("PosPaymentAccount")
  posRegisters      PosRegister[]         @relation("PosRegisterBank")
  posChangeOrders   PosOrder[]            @relation("PosChangeAccount")
  posOrderDeposits  PosOrder[]            @relation("PosOrderDeposit")

  @@unique([orgId, code])
  @@unique([orgId, systemKey])
  /// Target for the composite foreign key on journal_lines that makes a
  /// cross-organisation line structurally impossible (R9).
  @@unique([id, orgId])
  @@index([orgId, type, code])
  @@index([orgId, parentId])
  @@index([orgId, isActive])
  @@map("ledger_accounts")
}

model FiscalYear {
  id    String @id @default(cuid())
  orgId String

  /// The calendar year the fiscal year *begins* in. A year starting in April 2026
  /// and ending in March 2027 is fiscal year 2026.
  year      Int
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    PeriodStatus @default(OPEN)

  closedAt         DateTime? @db.Timestamptz(6)
  closingJournalId String?   @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  periods      AccountingPeriod[]

  @@unique([orgId, year])
  @@index([orgId, startDate])
  @@map("fiscal_years")
}

/// Twelve monthly periods per fiscal year, plus period 0 — a zero-length period
/// dated the day before the year begins, which is where opening balances land so
/// they never fall inside a reportable trading month.
model AccountingPeriod {
  id           String @id @default(cuid())
  orgId        String
  fiscalYearId String

  periodNumber Int          @db.SmallInt
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  status       PeriodStatus @default(OPEN)

  closedAt   DateTime? @db.Timestamptz(6)
  closedById String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journals     Journal[]

  @@unique([fiscalYearId, periodNumber])
  /// Every posting resolves its period by date, so this is the hottest index on
  /// the write path.
  @@index([orgId, startDate, endDate])
  @@map("accounting_periods")
}

/// A balanced set of entries. Immutable once posted (R4) — corrections are
/// reversals, enforced by trigger rather than by convention.
model Journal {
  id    String @id @default(cuid())
  orgId String

  journalNumber String
  /// Calendar date, not an instant: a 31 January entry belongs to January for
  /// every reader in every timezone.
  date          DateTime @db.Date
  periodId      String

  memo String?

  sourceType JournalSourceType
  /// The document that produced this journal, if any. Null for manual entries.
  sourceId   String?

  status         JournalStatus @default(POSTED)
  isAdjusting    Boolean       @default(false)
  isClosingEntry Boolean       @default(false)

  /// Set on a reversing journal, pointing at what it reverses. Unique, because a
  /// journal may be reversed exactly once — the back-relation `reversedBy` reads
  /// it from the other side.
  reversalOfId   String? @unique
  reversalReason String?

  /// Always the organisation's base currency and 1 until multi-currency lands.
  /// Written from the start so no backfill is ever needed (ADR-0006).
  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  /// Prevents a retried request from posting the same journal twice.
  idempotencyKey String?

  postedAt    DateTime @default(now()) @db.Timestamptz(6)
  createdById String?

  /// When this entry was deleted, and by whom. Set together with status DELETED
  /// and never unset — see `server/accounting/deletion.ts`.
  deletedAt   DateTime? @db.Timestamptz(6)
  deletedById String?
  deleteReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period       AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines        JournalLine[]
  salesDocuments    SalesDocument[]
  customerPayments  CustomerPayment[]
  purchaseDocuments PurchaseDocument[]
  billPayments      BillPayment[]
  bankTransfers     BankTransfer[]
  deposits          Deposit[]
  inventoryMovements InventoryTransaction[]
  inventoryAdjustments InventoryAdjustment[]
  storeTransfers StoreTransfer[]
  files LedgerFile[]

  reversalOf Journal? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy Journal? @relation("JournalReversal")


  @@unique([orgId, journalNumber])
  @@index([orgId, deletedAt])
  @@unique([orgId, idempotencyKey])
  /// Target for the composite foreign key on journal_lines (R9).
  @@unique([id, orgId])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, sourceType, sourceId])
  @@index([orgId, status])
  @@index([periodId])
  @@map("journals")
}

/// One side of one entry. A line is a debit or a credit, never both (R1).
model JournalLine {
  id        String @id @default(cuid())
  journalId String
  orgId     String

  lineNumber Int @db.SmallInt

  accountId String

  debit  Decimal @default(0) @db.Decimal(19, 4)
  credit Decimal @default(0) @db.Decimal(19, 4)

  description String?

  /// Denormalised from the journal, set authoritatively by a trigger. Redundant
  /// and worth it: every ledger and report query filters lines by date, and
  /// without it each one pays a join to the header.
  journalDate DateTime @db.Date

  /// Subledger dimensions. A line hitting the AR or AP control account must carry
  /// its counterparty (R7) — that is what makes the aging report and the control
  /// account balance two queries over the same rows rather than two numbers that
  /// have to be reconciled.
  ///
  /// The columns existed from Phase 2 so the rule could be enforced from the
  /// ledger's first row; Phase 3 added the tables and the foreign keys.
  customerId String?
  vendorId   String?

  /// Foreign-currency amounts, unused until multi-currency lands (ADR-0006).
  foreignDebit  Decimal? @db.Decimal(19, 4)
  foreignCredit Decimal? @db.Decimal(19, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  journal  Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account  LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendor   Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  /// Whether this line has been reconciled is recorded in a separate table, not
  /// as a column here. A posted line is immutable (R4), and marking it cleared
  /// would be a change to it — so the fact lives beside the line rather than on
  /// it. See ReconciliationEntry.
  reconciliation  ReconciliationEntry?
  matchedImports  ImportedTransaction[]

  /// R9 is enforced by *additional* composite foreign keys on
  /// (journalId, orgId) and (accountId, orgId), created in raw SQL by
  /// prisma/sql/ledger-integrity.sql.
  ///
  /// They are not modelled as Prisma relations on purpose: Prisma would then own
  /// `orgId` as a relation scalar shared by two relations and refuse to let a
  /// nested create set it. The guarantee belongs in the database either way, and
  /// this keeps the client API usable. The `@@unique([id, orgId])` indexes on
  /// Journal and LedgerAccount exist to be their targets.

  @@unique([journalId, lineNumber])
  /// The index the general ledger, trial balance and every report leans on.
  @@index([orgId, accountId, journalDate, id])
  @@index([journalId])
  @@index([orgId, customerId])
  @@index([orgId, vendorId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Master data  (Phase 3)
// ---------------------------------------------------------------------------

/// When a document falls due. Attached to customers and vendors as a default and
/// copied onto each document, so changing a term later never restates the due
/// date of an invoice already sent.
model PaymentTerm {
  id    String @id @default(cuid())
  orgId String

  name String
  type PaymentTermType @default(NET_DAYS)

  /// NET_DAYS: days after the document date. DAY_OF_MONTH: the day it is due.
  dueDays Int @default(30) @db.SmallInt

  /// Early-settlement discount: `discountPercent` off if paid within
  /// `discountDays`. Recorded here in Phase 3; applied in Phase 4.
  discountDays    Int?     @db.SmallInt
  discountPercent Decimal? @db.Decimal(9, 4)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customers         Customer[]
  vendors           Vendor[]
  documents         SalesDocument[]
  purchaseDocuments PurchaseDocument[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("payment_terms")
}

model Customer {
  id    String @id @default(cuid())
  orgId String

  /// What the business calls them. Unique per organisation, because two
  /// "Ahmed" entries on an aging report help nobody.
  displayName String
  companyName String?
  firstName   String?
  lastName    String?

  email  String?
  phone  String?
  mobile String?

  taxRegistrationNumber String?

  billingLine1      String?
  billingLine2      String?
  billingCity       String?
  billingRegion     String?
  billingPostalCode String?
  billingCountry    String? @db.Char(2)

  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingRegion     String?
  shippingPostalCode String?
  shippingCountry    String? @db.Char(2)

  paymentTermId String?
  /// Informational in Phase 3; Phase 4 warns when an invoice would exceed it.
  creditLimit   Decimal? @db.Decimal(19, 4)

  notes    String?
  /// Printed on the invoice as Sales person. The person who looks after this customer.
  salesPerson String?
  isActive Boolean @default(true)

  /// The day the debt was agreed. The ledger still uses the balance date.
  agreementDate DateTime? @db.Date
  /// The day the balance falls due. Kept on the customer so a reminder can find it.
  balanceDate   DateTime? @db.Date
  /// Clock time of the balance, as entered on the registration form.
  balanceTime   String?
  /// How many days before the balance time the warning appears. 3, 5, or 7.
  reminderDays  Int?      @db.SmallInt

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paymentTerm  PaymentTerm?  @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  journalLines JournalLine[]
  documents    SalesDocument[]
  payments     CustomerPayment[]
  deliveryNotes DeliveryNote[]
  files        CustomerFile[]
  importedLines ImportedTransaction[]
  bankRules     BankRule[]
  posRegisters  PosRegister[]

  @@unique([orgId, displayName])
  /// Target for the tenancy-carrying composite foreign key on journal_lines (R9).
  @@unique([id, orgId])
  @@index([orgId, isActive, displayName])
  @@map("customers")
}

/// A portrait or a debt-agreement paper kept with the customer who was registered.
enum CustomerFileKind {
  PHOTO
  AGREEMENT
}

model CustomerFile {
  id         String           @id @default(cuid())
  orgId      String
  customerId String
  kind       CustomerFileKind
  originalName String
  contentType  String
  byteSize     Int
  /// Path under the uploads directory. Never a public URL.
  storageKey   String
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orgId, customerId, kind])
  @@map("customer_files")
}

model Vendor {
  id    String @id @default(cuid())
  orgId String

  displayName String
  companyName String?
  firstName   String?
  lastName    String?

  email  String?
  phone  String?
  mobile String?

  taxRegistrationNumber String?

  billingLine1      String?
  billingLine2      String?
  billingCity       String?
  billingRegion     String?
  billingPostalCode String?
  billingCountry    String? @db.Char(2)

  paymentTermId String?

  /// Pre-selected on a bill, so routine spending is categorised the same way
  /// every time instead of landing in Uncategorised Expense.
  defaultExpenseAccountId String?

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paymentTerm           PaymentTerm?   @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  defaultExpenseAccount LedgerAccount? @relation("VendorDefaultExpense", fields: [defaultExpenseAccountId], references: [id], onDelete: SetNull)
  journalLines          JournalLine[]
  documents             PurchaseDocument[]
  payments              BillPayment[]
  importedLines         ImportedTransaction[]
  bankRules             BankRule[]

  @@unique([orgId, displayName])
  /// Target for the tenancy-carrying composite foreign key on journal_lines (R9).
  @@unique([id, orgId])
  @@index([orgId, isActive, displayName])
  @@map("vendors")
}

model ItemCategory {
  id    String @id @default(cuid())
  orgId String

  name     String
  parentId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     ItemCategory[] @relation("CategoryHierarchy")
  items        Item[]

  @@unique([orgId, name])
  @@map("item_categories")
}

/// A product or service.
///
/// Items carry their account mappings so posting is driven by master data rather
/// than by whoever is typing the invoice. Which mappings are required depends on
/// the type, and the rule is enforced in the service and by a database trigger:
///
///   SERVICE / NON_INVENTORY  income account; expense account optional
///   INVENTORY                income + inventory asset + COGS, all required
model Item {
  id    String @id @default(cuid())
  orgId String

  sku         String?
  name        String
  description String?
  type        ItemType @default(NON_INVENTORY)
  categoryId  String?

  unitOfMeasure String?

  salesDescription String?
  salesPrice       Decimal? @db.Decimal(19, 4)
  incomeAccountId  String?
  isTaxable        Boolean  @default(true)
  salesTaxCodeId   String?

  purchaseDescription String?
  purchaseCost        Decimal? @db.Decimal(19, 4)
  expenseAccountId    String?
  purchaseTaxCodeId   String?

  /// INVENTORY only. Stock movement and weighted-average cost arrive in Phase 7.
  inventoryAccountId String?
  cogsAccountId      String?
  reorderPoint       Decimal? @db.Decimal(19, 4)

  /// Which store holds this product. The store has its own inventory account.
  storeId String?

  isActive Boolean @default(true)

  /// When true, the item appears on the point-of-sale product grid.
  availableInPos Boolean @default(true)

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category         ItemCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  incomeAccount    LedgerAccount? @relation("ItemIncome", fields: [incomeAccountId], references: [id], onDelete: Restrict)
  expenseAccount   LedgerAccount? @relation("ItemExpense", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  inventoryAccount LedgerAccount? @relation("ItemInventory", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  cogsAccount      LedgerAccount? @relation("ItemCogs", fields: [cogsAccountId], references: [id], onDelete: Restrict)
  store            Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  salesTaxCode     TaxCode?       @relation("ItemSalesTax", fields: [salesTaxCodeId], references: [id], onDelete: SetNull)
  purchaseTaxCode  TaxCode?       @relation("ItemPurchaseTax", fields: [purchaseTaxCodeId], references: [id], onDelete: SetNull)
  salesLines       SalesDocumentLine[]
  purchaseLines    PurchaseDocumentLine[]
  movements        InventoryTransaction[]
  adjustmentLines  InventoryAdjustmentLine[]
  storeTransfers   StoreTransfer[]
  storeTickets     StoreTicket[]
  deliveryNoteLines DeliveryNoteLine[]

  @@unique([orgId, name])
  @@unique([orgId, sku])
  @@index([orgId, isActive, name])
  @@index([orgId, type])
  @@index([orgId, deletedAt])
  @@index([orgId, storeId])
  @@map("items")
}

/// A place the stock is kept. Each store has an inventory account of its own,
/// named with the store, listed with Inventory Asset on the chart.
model Store {
  id    String @id @default(cuid())
  orgId String

  name               String
  inventoryAccountId String
  isActive           Boolean @default(true)
  /// The office. Stock recorded before a store was chosen is counted here.
  isOffice           Boolean @default(false)

  /// Where the store sits — street / area.
  address String?
  /// Store phone so staff can reach that location.
  phone   String?
  /// Person who holds the physical key to this store.
  keyHolderName  String?
  /// Phone for the key holder (may differ from the store phone).
  keyHolderPhone String?
  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      LedgerAccount          @relation("StoreAccount", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  items        Item[]
  movements    InventoryTransaction[]
  salesLines   SalesDocumentLine[]
  purchaseLines PurchaseDocumentLine[]
  transfersOut StoreTransfer[] @relation("TransferFrom")
  transfersIn  StoreTransfer[] @relation("TransferTo")
  tickets      StoreTicket[]
  ticketsIn    StoreTicket[]   @relation("TicketToStore")
  deliveryNotes DeliveryNote[]
  posRegisters  PosRegister[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("stores")
}

// ---------------------------------------------------------------------------
// Point of sale
// ---------------------------------------------------------------------------

/// A way to take money at the till — mobile wallet, cash drawer, etc.
/// The orders report totals by this method. The money posts to the register's
/// bank account, not to this method's account.
model PosPaymentMethod {
  id              String @id @default(cuid())
  orgId           String

  name            String
  ledgerAccountId String
  /// Cashiers may hand change back from this method. The till can still turn it off.
  allowsChangeReturn Boolean @default(true)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0) @db.SmallInt

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation("PosPaymentAccount", fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  registers    PosRegisterMethod[]
  payments     PosOrderPayment[]
  changeOrders PosOrder[] @relation("PosChangeMethod")
  defaultOnRegisters PosRegister[] @relation("RegisterDefaultChange")

  @@unique([orgId, name])
  @@index([orgId, isActive, sortOrder])
  @@map("pos_payment_methods")
}

/// A physical or logical till. Links a default walk-in customer, store, and
/// its own bank sub-account under the POS Banks heading.
model PosRegister {
  id                String @id @default(cuid())
  orgId             String

  name              String
  storeId           String?
  defaultCustomerId String
  /// BANK sub-account under POS Banks. Nullable until the backfill runs.
  /// New sales debit this account. It keeps the balance until someone transfers it out.
  ledgerAccountId   String? @unique
  isActive          Boolean @default(true)
  /// Till setting: which method is selected when the Payment dialog opens. Null means cash.
  defaultChangeMethodId String?
  /// When off, change can only come back from a cash method, even if wallets are allowed below.
  allowWalletChangeReturn Boolean @default(true)

  /// bcrypt hash of the cashier PIN. Null until an admin sets one; those tills stay openable.
  pinHash String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store           Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  defaultCustomer Customer     @relation(fields: [defaultCustomerId], references: [id], onDelete: Restrict)
  account         LedgerAccount? @relation("PosRegisterBank", fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  defaultChangeMethod PosPaymentMethod? @relation("RegisterDefaultChange", fields: [defaultChangeMethodId], references: [id], onDelete: SetNull)
  methods         PosRegisterMethod[]
  staff           PosRegisterStaff[]
  sessions        PosSession[]
  orders          PosOrder[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@index([defaultChangeMethodId])
  @@map("pos_registers")
}

/// Who may work this counter. Empty = anyone with POS access.
model PosRegisterStaff {
  registerId String
  userId     String

  register PosRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([registerId, userId])
  @@index([userId])
  @@map("pos_register_staff")
}

/// A cash-control period on one register — open with opening float, close with counted cash.
model PosSession {
  id             String           @id @default(cuid())
  orgId          String
  registerId     String
  status         PosSessionStatus @default(OPEN)

  openedAt       DateTime @default(now()) @db.Timestamptz(6)
  closedAt       DateTime? @db.Timestamptz(6)
  openingCash    Decimal  @default(0) @db.Decimal(19, 4)
  closingCash    Decimal? @db.Decimal(19, 4)

  openedByUserId String
  closedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  register     PosRegister  @relation(fields: [registerId], references: [id], onDelete: Restrict)
  orders       PosOrder[]
  cashMoves    PosCashMovement[]

  @@index([orgId, status, openedAt(sort: Desc)])
  @@index([registerId, status])
  @@map("pos_sessions")
}

/// Manual cash put into / taken from the drawer during an open session.
model PosCashMovement {
  id             String          @id @default(cuid())
  orgId          String
  sessionId      String
  kind           PosCashMoveKind
  amount         Decimal         @db.Decimal(19, 4)
  reason         String?
  createdByUserId String
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)

  session PosSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("pos_cash_movements")
}

model PosRegisterMethod {
  registerId      String
  paymentMethodId String
  /// This till may hand change back from this method. Combined with the method's own flag.
  allowsChangeReturn Boolean @default(true)

  register      PosRegister      @relation(fields: [registerId], references: [id], onDelete: Cascade)
  paymentMethod PosPaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@id([registerId, paymentMethodId])
  @@map("pos_register_methods")
}

/// Links a posted sales receipt back to the till that raised it.
model PosOrder {
  id              String @id @default(cuid())
  orgId           String
  registerId      String
  sessionId       String?
  salesDocumentId String @unique

  /// Money handed back. Zero on sales rung up before change was recorded, and on exact tenders.
  changeAmount            Decimal @default(0) @db.Decimal(19, 4)
  changePaymentMethodId   String?
  changeLedgerAccountId   String?
  /// Register bank account this order posts to. Null on receipts posted before
  /// tills had their own bank account; those journals stay on the wallet accounts.
  depositLedgerAccountId  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  register      PosRegister       @relation(fields: [registerId], references: [id], onDelete: Restrict)
  session       PosSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  salesDocument SalesDocument     @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)
  changePaymentMethod PosPaymentMethod? @relation("PosChangeMethod", fields: [changePaymentMethodId], references: [id], onDelete: Restrict)
  changeAccount       LedgerAccount?    @relation("PosChangeAccount", fields: [changeLedgerAccountId], references: [id], onDelete: Restrict)
  depositAccount      LedgerAccount?    @relation("PosOrderDeposit", fields: [depositLedgerAccountId], references: [id], onDelete: Restrict)
  payments      PosOrderPayment[]

  @@index([orgId, registerId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([changePaymentMethodId])
  @@index([depositLedgerAccountId])
  @@map("pos_orders")
}

model PosOrderPayment {
  id              String @id @default(cuid())
  orderId         String
  paymentMethodId String
  ledgerAccountId String
  amount          Decimal @db.Decimal(19, 4)

  order         PosOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod PosPaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("pos_order_payments")
}

// ---------------------------------------------------------------------------
// Tax  (Phase 3 defines it; Phase 4 posts it)
// ---------------------------------------------------------------------------

/// Who the tax is owed to, and how often it is filed.
model TaxAgency {
  id    String @id @default(cuid())
  orgId String

  name             String
  registrationNumber String?
  filingFrequency  TaxFilingFrequency @default(MONTHLY)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rates        TaxRate[]

  @@unique([orgId, name])
  @@map("tax_agencies")
}

/// A single percentage owed to one agency.
///
/// The rate is stored as a fraction (0.15, not 15) at nine decimal places, so a
/// third-of-a-percent levy does not have to be rounded before it is applied.
model TaxRate {
  id    String @id @default(cuid())
  orgId String

  name     String
  rate     Decimal        @db.Decimal(19, 9)
  agencyId String
  appliesTo TaxApplication @default(BOTH)

  /// Where the tax lands. Sales tax collected is a liability; purchase tax is an
  /// asset where it is recoverable, and simply part of the cost where it is not.
  salesAccountId    String?
  purchaseAccountId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agency          TaxAgency      @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  salesAccount    LedgerAccount? @relation("TaxRateSales", fields: [salesAccountId], references: [id], onDelete: Restrict)
  purchaseAccount LedgerAccount? @relation("TaxRatePurchase", fields: [purchaseAccountId], references: [id], onDelete: Restrict)
  components      TaxCodeRate[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("tax_rates")
}

/// What a user picks on a document line. One code combines one or more rates,
/// which is what makes compound and multi-jurisdiction tax expressible.
model TaxCode {
  id    String @id @default(cuid())
  orgId String

  name        String
  description String?

  /// True when the price a customer sees already contains the tax, and the tax
  /// must be extracted from it rather than added to it.
  isInclusive Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  components    TaxCodeRate[]
  salesItems    Item[]        @relation("ItemSalesTax")
  purchaseItems Item[]        @relation("ItemPurchaseTax")
  salesLines    SalesDocumentLine[]
  purchaseLines PurchaseDocumentLine[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("tax_codes")
}

/// One rate's part in one code.
model TaxCodeRate {
  id        String @id @default(cuid())
  orgId     String
  taxCodeId String
  taxRateId String

  /// Order of application. A compound rate is charged on the running total
  /// including the rates before it, so the sequence changes the answer.
  sequence   Int     @default(1) @db.SmallInt
  isCompound Boolean @default(false)

  taxCode TaxCode @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)
  taxRate TaxRate @relation(fields: [taxRateId], references: [id], onDelete: Restrict)

  @@unique([taxCodeId, taxRateId])
  @@index([taxCodeId, sequence])
  @@map("tax_code_rates")
}

// ---------------------------------------------------------------------------
// Sales  (Phase 4)
// ---------------------------------------------------------------------------

/// Every customer-facing document. See `SalesDocumentType` for why they share a
/// table.
///
/// Totals are stored, not derived. They are what the customer was shown and what
/// the ledger was told, and recomputing them later from prices that may since
/// have changed would quietly restate a document that has already been sent.
/// The **outstanding balance** is the opposite: always derived from applications,
/// so it cannot drift.
model SalesDocument {
  id    String @id @default(cuid())
  orgId String

  type   SalesDocumentType
  number String

  customerId String
  date       DateTime  @db.Date
  dueDate    DateTime? @db.Date
  /// Copied from the customer at creation, so changing a term later never
  /// restates the due date of a document already sent.
  paymentTermId String?
  expiryDate    DateTime? @db.Date

  status SalesDocumentStatus @default(DRAFT)

  /// The customer's own order number, printed on the document.
  reference       String?
  memo            String?
  customerMessage String?

  subtotal Decimal @default(0) @db.Decimal(19, 4)
  discountAmount Decimal @default(0) @db.Decimal(19, 4)
  taxTotal Decimal @default(0) @db.Decimal(19, 4)
  total    Decimal @default(0) @db.Decimal(19, 4)

  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  /// Where the money landed, for documents that move cash immediately.
  /// Required for SALES_RECEIPT and REFUND_RECEIPT, unused otherwise.
  depositAccountId String?

  /// The journal currently representing this document. Null for drafts and
  /// estimates. An edit reverses the old journal and points this at the new one.
  journalId String?
  /// Bumped on every re-post, so the audit trail can be read in order.
  version   Int    @default(1)

  /// Set on the invoice an estimate became.
  convertedFromId String? @unique

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentTerm    PaymentTerm?        @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  depositAccount LedgerAccount?      @relation("SalesDepositAccount", fields: [depositAccountId], references: [id], onDelete: Restrict)
  journal        Journal?            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines          SalesDocumentLine[]

  convertedFrom SalesDocument? @relation("EstimateConversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  convertedTo   SalesDocument? @relation("EstimateConversion")

  /// Applications *against* this document — what has settled it.
  applications    SalesApplication[] @relation("AppliedToInvoice")
  /// Applications *from* this document, when it is a credit memo.
  creditsApplied  SalesApplication[] @relation("AppliedFromCredit")

  deliveryNotes DeliveryNote[]
  storeTickets  StoreTicket[]
  posOrder      PosOrder?

  @@unique([orgId, type, number])
  @@unique([id, orgId])
  @@index([orgId, type, status, date(sort: Desc)])
  @@index([orgId, customerId, date(sort: Desc)])
  @@index([orgId, dueDate])
  @@index([orgId, deletedAt])
  @@map("sales_documents")
}

model SalesDocumentLine {
  id         String @id @default(cuid())
  documentId String
  orgId      String

  lineNumber Int @db.SmallInt

  itemId      String?
  description String?

  quantity  Decimal @default(1) @db.Decimal(19, 4)
  unitPrice Decimal @default(0) @db.Decimal(19, 4)

  /// Line-level discount, taken off before tax.
  discountPercent Decimal? @db.Decimal(9, 4)

  /// quantity x unitPrice, less the discount. Tax-exclusive.
  amount Decimal @default(0) @db.Decimal(19, 4)

  taxCodeId String?
  taxAmount Decimal @default(0) @db.Decimal(19, 4)

  /// Resolved from the item at posting time and frozen here, so re-reading the
  /// document years later shows where the money actually went, even if the item
  /// has since been remapped.
  incomeAccountId String?

  /// The store this line is issued from, or returned to.
  storeId String?

  serviceDate DateTime? @db.Date

  document      SalesDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item          Item?          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode       TaxCode?       @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  incomeAccount LedgerAccount? @relation("SalesLineIncome", fields: [incomeAccountId], references: [id], onDelete: Restrict)
  store         Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([documentId, lineNumber])
  @@index([orgId, itemId])
  @@map("sales_document_lines")
}

/// Money received from a customer.
///
/// A payment is not "an invoice marked paid": it is its own document, which may
/// settle several invoices, part of one, or none at all. Unapplied cash sits on
/// the balance sheet as a customer credit, which is exactly where it belongs.
model CustomerPayment {
  id    String @id @default(cuid())
  orgId String

  number     String
  customerId String
  date       DateTime @db.Date

  amount Decimal @db.Decimal(19, 4)

  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  memo      String?

  /// Bank account, or Undeposited Funds when the money is in hand but not yet
  /// taken to the bank.
  depositAccountId String

  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  journalId String?
  status    SalesDocumentStatus @default(OPEN)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  depositAccount LedgerAccount      @relation("PaymentDepositAccount", fields: [depositAccountId], references: [id], onDelete: Restrict)
  journal        Journal?           @relation(fields: [journalId], references: [id], onDelete: Restrict)
  applications   SalesApplication[]
  depositLines   DepositLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, customerId, date(sort: Desc)])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@map("customer_payments")
}

/// What settled what.
///
/// An invoice's outstanding balance is `total - sum(applications)`. Keeping that
/// derived rather than stored is what allows partial payments, one payment across
/// many invoices, credit memos used as payment and unapplied cash — without any
/// of them being a special case, and without a stored figure that can drift.
///
/// Exactly one source: a payment, or a credit memo. A CHECK enforces it.
model SalesApplication {
  id    String @id @default(cuid())
  orgId String

  paymentId        String?
  creditDocumentId String?

  invoiceId String
  amount    Decimal @db.Decimal(19, 4)

  appliedAt DateTime @default(now()) @db.Timestamptz(6)

  payment        CustomerPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  creditDocument SalesDocument?   @relation("AppliedFromCredit", fields: [creditDocumentId], references: [id], onDelete: Cascade)
  invoice        SalesDocument    @relation("AppliedToInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@unique([creditDocumentId, invoiceId])
  @@index([orgId, invoiceId])
  @@map("sales_applications")
}

// ---------------------------------------------------------------------------
// Purchases  (Phase 5)
// ---------------------------------------------------------------------------

/// Bills, expenses, vendor credits and purchase orders.
///
/// Deliberately the mirror of `SalesDocument`, field for field where the meaning
/// is the same. Two subledgers that behave differently is a source of bugs and of
/// arguments; two that behave identically is one thing to learn.
model PurchaseDocument {
  id    String @id @default(cuid())
  orgId String

  type   PurchaseDocumentType
  number String

  vendorId String
  date     DateTime  @db.Date
  dueDate  DateTime? @db.Date
  /// Copied from the vendor at creation, so changing a term later never restates
  /// the due date of a bill already entered.
  paymentTermId String?
  expiryDate    DateTime? @db.Date

  status PurchaseDocumentStatus @default(DRAFT)

  /// The vendor's own document number — what to quote when querying it.
  reference String?
  memo      String?

  subtotal Decimal @default(0) @db.Decimal(19, 4)
  taxTotal Decimal @default(0) @db.Decimal(19, 4)
  total    Decimal @default(0) @db.Decimal(19, 4)

  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  /// Where the money came from. Required for EXPENSE, unused otherwise.
  paymentAccountId String?

  journalId String?
  version   Int    @default(1)

  /// Set on each bill raised against a purchase order.
  ///
  /// Not unique. An order is rarely filled in one delivery: half the pallets
  /// arrive on Tuesday and the rest a fortnight later, and each arrival is its
  /// own bill against the same order. Requiring one bill per order is what
  /// forced the whole order to be received at once whether or not it had all
  /// turned up.
  convertedFromId String?

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor         Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paymentTerm    PaymentTerm?           @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  paymentAccount LedgerAccount?         @relation("PurchasePaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)
  journal        Journal?               @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines          PurchaseDocumentLine[]

  convertedFrom PurchaseDocument?  @relation("OrderConversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  /// The bills raised against this order, oldest first.
  convertedTo   PurchaseDocument[] @relation("OrderConversion")

  applications   PurchaseApplication[] @relation("AppliedToBill")
  creditsApplied PurchaseApplication[] @relation("AppliedFromVendorCredit")

  @@unique([orgId, type, number])
  @@unique([id, orgId])
  @@index([orgId, type, status, date(sort: Desc)])
  @@index([orgId, vendorId, date(sort: Desc)])
  @@index([orgId, dueDate])
  @@index([convertedFromId])
  @@index([orgId, deletedAt])
  @@map("purchase_documents")
}

model PurchaseDocumentLine {
  id         String @id @default(cuid())
  documentId String
  orgId      String

  lineNumber Int @db.SmallInt

  itemId      String?
  description String?

  quantity  Decimal @default(1) @db.Decimal(19, 4)
  unitPrice Decimal @default(0) @db.Decimal(19, 4)

  /// How much of this line has arrived. Only meaningful on a purchase order,
  /// where it is what separates "ordered" from "still to come".
  ///
  /// It is kept on the order rather than derived from the bills raised against
  /// it because a bill can be edited or voided after the fact, and an order that
  /// silently re-opened itself when somebody corrected a bill would be worse
  /// than one that never closed. The receiving service is the only writer.
  quantityReceived Decimal @default(0) @db.Decimal(19, 4)

  discountPercent Decimal? @db.Decimal(9, 4)

  amount Decimal @default(0) @db.Decimal(19, 4)

  taxCodeId String?
  taxAmount Decimal @default(0) @db.Decimal(19, 4)

  /// Where the cost lands: an expense account, or an asset account for something
  /// capitalised. Resolved at posting time and frozen, so re-reading the bill
  /// years later shows where the money actually went.
  expenseAccountId String?

  /// The store this line is received into, or returned from.
  storeId String?

  document        PurchaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item            Item?            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode         TaxCode?         @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  expenseAccount  LedgerAccount?   @relation("PurchaseLineExpense", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  store           Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([documentId, lineNumber])
  @@index([orgId, itemId])
  @@map("purchase_document_lines")
}

/// Money paid to a vendor. The mirror of `CustomerPayment`.
model BillPayment {
  id    String @id @default(cuid())
  orgId String

  number   String
  vendorId String
  date     DateTime @db.Date

  amount Decimal @db.Decimal(19, 4)

  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  memo      String?

  /// Bank or credit card the money left from.
  paymentAccountId String

  currencyCode String  @db.Char(3)
  exchangeRate Decimal @default(1) @db.Decimal(19, 9)

  journalId String?
  status    PurchaseDocumentStatus @default(OPEN)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor         Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paymentAccount LedgerAccount         @relation("BillPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)
  journal        Journal?              @relation(fields: [journalId], references: [id], onDelete: Restrict)
  applications   PurchaseApplication[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, vendorId, date(sort: Desc)])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@map("bill_payments")
}

/// What settled which bill. Exactly one source: a payment, or a vendor credit.
model PurchaseApplication {
  id    String @id @default(cuid())
  orgId String

  paymentId        String?
  creditDocumentId String?

  billId String
  amount Decimal @db.Decimal(19, 4)

  appliedAt DateTime @default(now()) @db.Timestamptz(6)

  payment        BillPayment?      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  creditDocument PurchaseDocument? @relation("AppliedFromVendorCredit", fields: [creditDocumentId], references: [id], onDelete: Cascade)
  bill           PurchaseDocument  @relation("AppliedToBill", fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@unique([creditDocumentId, billId])
  @@index([orgId, billId])
  @@map("purchase_applications")
}

// ---------------------------------------------------------------------------
// Banking  (Phase 6)
// ---------------------------------------------------------------------------

/// Money moved between two of the business's own accounts.
///
/// Not income, not an expense — nothing has been earned or spent, so this posts
/// only between two asset or liability accounts. Recording a transfer as a sale
/// on one side and a purchase on the other is one of the commonest ways a set of
/// books ends up overstating both.
model BankTransfer {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  fromAccountId String
  toAccountId   String
  amount        Decimal @db.Decimal(19, 4)

  memo      String?
  reference String?

  currencyCode String @db.Char(3)

  journalId String?
  status    BankDocumentStatus @default(POSTED)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fromAccount  LedgerAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount    LedgerAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  journal      Journal?      @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, deletedAt])
  @@map("bank_transfers")
}

/// Taking money to the bank.
///
/// Payments received into Undeposited Funds sit there until someone physically
/// banks them. A deposit clears that holding account and puts the money where the
/// bank statement will show it — which is what makes the register match the
/// statement line for line, rather than showing five payments where the bank
/// shows one paying-in slip.
model Deposit {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  bankAccountId String
  total         Decimal @db.Decimal(19, 4)

  memo      String?
  reference String?

  currencyCode String @db.Char(3)

  journalId String?
  status    BankDocumentStatus @default(POSTED)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bankAccount  LedgerAccount @relation("DepositBankAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)
  journal      Journal?      @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines        DepositLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, deletedAt])
  @@map("deposits")
}

/// One item on a paying-in slip.
///
/// Either a customer payment being cleared out of Undeposited Funds, or money
/// from somewhere else entirely — bank interest, a refund, an owner's injection.
/// Exactly one of the two, enforced by a CHECK.
model DepositLine {
  id        String @id @default(cuid())
  depositId String
  orgId     String

  lineNumber Int @db.SmallInt

  /// Set when this line clears a payment out of Undeposited Funds.
  customerPaymentId String?
  /// Set when the money came from somewhere other than a customer payment.
  accountId         String?

  description String?
  amount      Decimal @db.Decimal(19, 4)

  deposit         Deposit          @relation(fields: [depositId], references: [id], onDelete: Cascade)
  customerPayment CustomerPayment? @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)
  account         LedgerAccount?   @relation("DepositLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([depositId, lineNumber])
  @@unique([customerPaymentId])
  @@index([orgId, depositId])
  @@map("deposit_lines")
}

/// A line read from a bank statement, before anyone has decided what it is.
///
/// Kept separate from the ledger on purpose: an imported row is a claim by the
/// bank, not an entry in the books. It becomes an entry only when someone matches
/// it to something already posted, or uses it to create something.
model ImportedTransaction {
  id    String @id @default(cuid())
  orgId String

  accountId String

  date        DateTime @db.Date
  description String
  reference   String?

  /// Signed as the statement reads it: positive money in, negative money out.
  amount Decimal @db.Decimal(19, 4)

  /// The bank's own identifier where the file provides one, used to avoid
  /// importing the same line twice.
  externalId String?

  status ImportedTransactionStatus @default(PENDING)

  matchedJournalLineId String?
  matchedAt            DateTime? @db.Timestamptz(6)

  /// Chosen on the feed before the line is posted. Not a ledger entry.
  categoryAccountId String?
  vendorId          String?
  customerId        String?

  importedAt   DateTime @default(now()) @db.Timestamptz(6)
  importedById String?

  organization       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account            LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryAccount    LedgerAccount?  @relation("ImportCategory", fields: [categoryAccountId], references: [id], onDelete: SetNull)
  vendor             Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  matchedJournalLine JournalLine?    @relation(fields: [matchedJournalLineId], references: [id], onDelete: SetNull)
  files              LedgerFile[]

  @@unique([orgId, accountId, externalId])
  @@index([orgId, accountId, status, date])
  @@map("imported_transactions")
}

/// One reconciliation of one account against one statement.
model BankReconciliation {
  id    String @id @default(cuid())
  orgId String

  accountId String

  statementDate           DateTime @db.Date
  /// What the statement says the account held on that date.
  statementEndingBalance  Decimal  @db.Decimal(19, 4)
  /// The total of everything reconciled before this one. Recorded rather than
  /// recomputed, so a finished reconciliation reads the same for ever.
  beginningBalance        Decimal  @db.Decimal(19, 4)

  status ReconciliationStatus @default(IN_PROGRESS)

  notes String?

  startedAt     DateTime  @default(now()) @db.Timestamptz(6)
  startedById   String?
  completedAt   DateTime? @db.Timestamptz(6)
  completedById String?

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      LedgerAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries      ReconciliationEntry[]

  @@index([orgId, accountId, statementDate(sort: Desc)])
  @@map("bank_reconciliations")
}

/// One journal line marked as cleared by one reconciliation.
///
/// This table exists because a posted journal line is immutable (R4). Setting a
/// `cleared` flag on the line would be a change to it, and the trigger would
/// refuse — rightly. Recording the fact beside the line instead keeps the ledger
/// append-only and, as a bonus, keeps the full history of which reconciliation
/// cleared what.
model ReconciliationEntry {
  id    String @id @default(cuid())
  orgId String

  reconciliationId String
  journalLineId    String

  clearedAt DateTime @default(now()) @db.Timestamptz(6)

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  journalLine    JournalLine        @relation(fields: [journalLineId], references: [id], onDelete: Restrict)

  /// A line can be cleared by at most one reconciliation.
  @@unique([journalLineId])
  @@index([orgId, reconciliationId])
  @@map("reconciliation_entries")
}

// ---------------------------------------------------------------------------
// Inventory  (Phase 7)
// ---------------------------------------------------------------------------

/// Every movement of stock, and what it did to the average cost.
///
/// This is a ledger in its own right, and it obeys the same discipline as the
/// general ledger: append-only, one row per event, running totals carried on the
/// row rather than recomputed. Its total value must always equal the Inventory
/// Asset balance in the general ledger — because every movement posts exactly its
/// own `value` there, in the same transaction that writes this row.
model InventoryTransaction {
  id     String @id @default(cuid())
  orgId  String
  itemId String

  date DateTime              @db.Date
  type InventoryMovementType

  /// What caused it, so a movement can be traced back to its document.
  sourceType   JournalSourceType
  sourceId     String?
  sourceLineId String?

  /// Signed: positive received, negative issued.
  quantity Decimal @db.Decimal(19, 4)

  /// Cost per unit for this movement. On a receipt, what was paid. On an issue,
  /// the weighted average at the moment it was issued. Six decimals because a
  /// per-unit cost divides badly and rounding it early moves the total.
  unitCost Decimal @db.Decimal(19, 6)

  /// Signed value change, and what is posted to the Inventory Asset account.
  value Decimal @db.Decimal(19, 4)

  /// The item's position after this movement.
  runningQuantity Decimal @db.Decimal(19, 4)
  runningValue    Decimal @db.Decimal(19, 4)

  /// Monotonic per item, in the order movements were recorded. See
  /// docs/phases/phase-07-inventory.md on why entry order rather than date order.
  sequence Int

  journalId String?

  /// Which store this quantity belongs to. Null is counted at the office.
  storeId String?

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdById String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  journal      Journal?     @relation(fields: [journalId], references: [id], onDelete: Restrict)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([itemId, sequence])
  @@index([orgId, itemId, sequence(sort: Desc)])
  @@index([orgId, date])
  @@index([orgId, sourceType, sourceId])
  @@map("inventory_transactions")
}

/// A count, a write-off, or a revaluation.
model InventoryAdjustment {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  /// Where the difference goes — normally Inventory Shrinkage.
  accountId String

  memo   String?
  reason String?

  status BankDocumentStatus @default(POSTED)

  journalId String?

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  /// Soft deletion. The row stays and its journal stays; both are excluded from
  /// every list, report, selector and balance. See `server/accounting/deletion.ts`.
  deletedAt    DateTime? @db.Timestamptz(6)
  deletedById  String?
  deleteReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      LedgerAccount             @relation("AdjustmentAccount", fields: [accountId], references: [id], onDelete: Restrict)
  journal      Journal?                  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines        InventoryAdjustmentLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, deletedAt])

  @@map("inventory_adjustments")
}

model InventoryAdjustmentLine {
  id           String @id @default(cuid())
  adjustmentId String
  orgId        String

  lineNumber Int @db.SmallInt
  itemId     String

  /// What the count says is actually there.
  countedQuantity Decimal @db.Decimal(19, 4)
  /// What the books said before the adjustment, kept so the document can be read
  /// years later without recomputing history.
  previousQuantity Decimal @db.Decimal(19, 4)
  /// countedQuantity - previousQuantity.
  quantityChange Decimal @db.Decimal(19, 4)

  unitCost Decimal @db.Decimal(19, 6)
  value    Decimal @db.Decimal(19, 4)

  description String?

  adjustment InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item       Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, lineNumber])
  @@index([orgId, itemId])
  @@map("inventory_adjustment_lines")
}

/// Stock moved from one store to another. Quantity and value leave one store
/// and arrive at the other; the item's global average cost does not change.
model StoreTransfer {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  fromStoreId String
  toStoreId   String
  itemId      String

  quantity Decimal @db.Decimal(19, 4)
  unitCost Decimal @db.Decimal(19, 6)
  value    Decimal @db.Decimal(19, 4)

  memo String?

  status    BankDocumentStatus @default(POSTED)
  journalId String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fromStore    Store        @relation("TransferFrom", fields: [fromStoreId], references: [id], onDelete: Restrict)
  toStore      Store        @relation("TransferTo", fields: [toStoreId], references: [id], onDelete: Restrict)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  journal      Journal?     @relation(fields: [journalId], references: [id], onDelete: Restrict)
  ticket       StoreTicket?

  @@unique([orgId, number])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, fromStoreId])
  @@index([orgId, toStoreId])
  @@index([orgId, itemId])
  @@map("store_transfers")
}

/// Ticket for stock taken from a store. Auto-made on transfer or sale, or entered by hand.
model StoreTicket {
  id    String @id @default(cuid())
  orgId String

  number String
  date   DateTime @db.Date

  /// Store the goods left.
  storeId String
  /// Store that received them (when this ticket moved stock between stores).
  toStoreId String?
  itemId    String

  quantity Decimal @db.Decimal(19, 4)
  unitCost Decimal @db.Decimal(19, 6)
  value    Decimal @db.Decimal(19, 4)

  /// Who took the goods (name), when known.
  takenBy String?
  memo    String?

  /// AUTO = transfer. MANUAL = ticket form. SALE = issued with an invoice/receipt.
  origin String @default("AUTO")

  transferId String? @unique

  /// Sale that caused this ticket (invoice or sales receipt).
  salesDocumentId     String?
  salesDocumentLineId String?
  /// Delivery note that lists this ticket's item for the customer/carrier.
  deliveryNoteId      String?

  status BankDocumentStatus @default(POSTED)

  /// When the store keeper marked goods prepared / handed to the customer.
  preparedAt   DateTime? @db.Timestamptz(6)
  preparedById String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  toStore      Store?         @relation("TicketToStore", fields: [toStoreId], references: [id], onDelete: Restrict)
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  transfer     StoreTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  salesDocument SalesDocument? @relation(fields: [salesDocumentId], references: [id], onDelete: SetNull)
  deliveryNote  DeliveryNote?  @relation(fields: [deliveryNoteId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, storeId])
  @@index([orgId, storeId, preparedAt])
  @@index([orgId, itemId])
  @@index([orgId, salesDocumentId])
  @@index([orgId, deliveryNoteId])
  @@map("store_tickets")
}

/// Customer delivery note (packing / dispatch advice) for goods leaving on a sale.
///
/// Created automatically when an invoice or sales receipt posts stock out. One
/// note per sale document; the carrier and the customer can print it. It is not
/// a ledger document — the invoice/receipt already posted the books.
model DeliveryNote {
  id    String @id @default(cuid())
  orgId String

  number String
  /// Business date of the sale (same calendar day as the invoice/receipt).
  date   DateTime @db.Date
  /// Clock time the note was issued (dispatch / loading time).
  issuedAt DateTime @default(now()) @db.Timestamptz(6)

  customerId      String
  salesDocumentId String

  /// Primary store the goods left from, when every line shares one.
  storeId String?

  /// Free text for the carrier, vehicle, or loading bay.
  carrier String?
  /// Instructions or remarks printed on the note.
  notes   String?

  status BankDocumentStatus @default(POSTED)

  voidedAt   DateTime? @db.Timestamptz(6)
  voidReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization  Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesDocument SalesDocument      @relation(fields: [salesDocumentId], references: [id], onDelete: Restrict)
  store         Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  lines         DeliveryNoteLine[]
  tickets       StoreTicket[]

  @@unique([orgId, number])
  @@unique([orgId, salesDocumentId])
  @@index([orgId, date(sort: Desc)])
  @@index([orgId, customerId, date(sort: Desc)])
  @@index([orgId, status])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id             String @id @default(cuid())
  deliveryNoteId String
  orgId          String

  lineNumber Int @db.SmallInt

  itemId      String?
  description String?
  quantity    Decimal @db.Decimal(19, 4)
  storeId     String?

  /// Line on the invoice/receipt this packing line came from.
  salesDocumentLineId String?

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  item         Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([deliveryNoteId, lineNumber])
  @@index([orgId, deliveryNoteId])
  @@map("delivery_note_lines")
}

// ---------------------------------------------------------------------------
// Workspace, bank rules, report notes, and papers on a transaction
// ---------------------------------------------------------------------------

/// A saved link (shortcut) or a pinned app, for one person in one organisation.
model WorkspaceBookmark {
  id     String @id @default(cuid())
  orgId  String
  userId String

  label String
  href  String
  /// `shortcut` is a page they bookmarked. `pin` is an app they want on Home.
  kind  String
  sort  Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, href, kind])
  @@index([orgId, userId, kind, sort])
  @@map("workspace_bookmarks")
}

/// When a bank description contains this text, suggest this payee and category.
model BankRule {
  id    String @id @default(cuid())
  orgId String

  name     String
  /// Compared case-insensitively against the bank description.
  contains String

  /// Empty means the rule applies to every bank account.
  accountId         String?
  categoryAccountId String
  vendorId          String?
  customerId        String?

  active Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account         LedgerAccount? @relation("RuleBank", fields: [accountId], references: [id], onDelete: Cascade)
  categoryAccount LedgerAccount  @relation("RuleCategory", fields: [categoryAccountId], references: [id], onDelete: Restrict)
  vendor          Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([orgId, active])
  @@map("bank_rules")
}

/// A note kept on a report, for the organisation, not for one date range.
model ReportNote {
  id        String @id @default(cuid())
  orgId     String
  reportKey String
  body      String

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, reportKey])
  @@map("report_notes")
}

/// A receipt or other paper kept against a bank line, a journal, or a purchase.
model LedgerFile {
  id    String @id @default(cuid())
  orgId String

  originalName String
  contentType  String
  byteSize     Int
  storageKey   String

  importedTransactionId String?
  journalId             String?
  purchaseDocumentId    String?

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdById String?

  organization        Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  importedTransaction ImportedTransaction? @relation(fields: [importedTransactionId], references: [id], onDelete: Cascade)
  journal             Journal?             @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([orgId, importedTransactionId])
  @@index([orgId, journalId])
  @@index([orgId, purchaseDocumentId])
  @@map("ledger_files")
}

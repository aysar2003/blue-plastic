// Blue Plastic Center — accounting system
//
// Phase 1: organisation, identity, auditing, document numbering.
// Phase 2: the ledger — chart of accounts, fiscal periods, journals and lines.
// Phase 3: master data — customers, vendors, items, tax and payment terms.
// Phase 4: sales — invoices, estimates, receipts, credit memos, payments.
// Phase 5: purchases — bills, expenses, vendor credits, purchase orders.
// Phase 6: banking — transfers, deposits, statement import, reconciliation.
// Phase 7: inventory — stock movements, weighted-average cost, COGS.
//
// The integrity rules that make this a real double-entry ledger (R1–R10 in
// docs/02-accounting-design.md) are enforced by database triggers, which Prisma
// cannot model. They live in prisma/sql/ and are applied by migrations;
// `pnpm db:verify` asserts they are still present in the connected database.

generator client {
  provider      = "prisma-client-js"
  /// Native for local/dev; Vercel serverless is Amazon Linux (OpenSSL 3).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Prisma 7 moved connection URLs out of the schema: migrations read them from
// `prisma.config.ts`, and the client receives a driver adapter (see server/db.ts).
datasource db {
  provider = "postgresql"
}


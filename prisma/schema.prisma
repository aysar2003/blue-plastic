/// Named approval workflow / rule (COSO / SOX maker-checker).
/// Many rules per document family — first match by priority wins.
/// Amount in [minAmount, maxAmount) needs this workflow; null max = no ceiling.
model ApprovalPolicy {
  id         String             @id @default(cuid())
  orgId      String
  /// Human name, e.g. "Large invoices" or "All bills".
  name       String
  entityType ApprovalEntityType
  enabled    Boolean            @default(true)
  /// Narrow within a family: e.g. INVOICE, SALES_ORDER, PURCHASE_ORDER.
  /// Null = every kind in that family (Sales, Purchases, …).
  documentKind String?
  /// Inclusive floor in org currency.
  minAmount  Decimal            @default(0) @db.Decimal(19, 4)
  /// Exclusive ceiling. Null = unlimited.
  maxAmount  Decimal?           @db.Decimal(19, 4)
  /// Lower number = checked first when several rules match the type.
  priority   Int                @default(100)
  /// Maker may not approve their own submission (SOX segregation of duties).
  /// Owner/Admin bypass create-time gating entirely and may still self-approve.
  requireDifferentApprover Boolean @default(true)
  /// Sequential approval steps (1 = classic maker-checker, 2–3 = escalation).
  levels Int @default(1) @db.SmallInt
  /// READY = installed from a pack (Odoo / QBO style). CUSTOM = built here.
  source   String  @default("CUSTOM")
  /// Pack key when source is READY, e.g. "standard" or "amount-bands".
  packKey  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  approvers    ApprovalPolicyApprover[]
  requests     ApprovalRequest[]

  @@index([orgId, entityType, enabled, priority])
  @@index([orgId, entityType, documentKind])
  @@index([orgId, enabled])
  @@map("approval_policies")
}

/// People allowed to decide a workflow. Empty list = anyone with the Approve permission.
model ApprovalPolicyApprover {
  id       String @id @default(cuid())
  orgId    String
  policyId String
  userId   String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policy       ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([policyId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("approval_policy_approvers")
}

/// One submit → approve/reject cycle for a document or master record.
model ApprovalRequest {
  id         String                @id @default(cuid())
  orgId      String
  entityType ApprovalEntityType
  entityId   String
  /// Human label for the inbox (e.g. "Invoice INV-1042").
  title      String
  /// Deep link inside the app.
  href       String
  amount     Decimal?              @db.Decimal(19, 4)
  currencyCode String?             @db.Char(3)
  status     ApprovalRequestStatus @default(PENDING)
  currentLevel Int                 @default(1) @db.SmallInt
  requiredLevels Int               @default(1) @db.SmallInt
  note       String?
  /// Workflow that gated this document. Null on older rows or after the rule was deleted.
  policyId   String?

  submittedById String
  submittedAt   DateTime @default(now()) @db.Timestamptz(6)
  decidedAt     DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  submittedBy  User               @relation("ApprovalSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  policy       ApprovalPolicy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  decisions    ApprovalDecision[]

  @@index([orgId, status, submittedAt])
  @@index([orgId, entityType, entityId])
  @@index([submittedById])
  @@index([policyId])
  @@map("approval_requests")
}

model ApprovalDecision {
  id        String @id @default(cuid())
  requestId String
  orgId     String
  level     Int    @db.SmallInt
  /// APPROVED or REJECTED for this level.
  decision  ApprovalRequestStatus
  note      String?
  decidedById String
  decidedAt   DateTime @default(now()) @db.Timestamptz(6)

  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy User            @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([orgId, decidedAt])
  @@map("approval_decisions")
}

/// A receipt or other paper kept against a bank line, journal, sale, or purchase.
model LedgerFile {
  id    String @id @default(cuid())
  orgId String

  originalName String
  contentType  String
  byteSize     Int
  storageKey   String

  importedTransactionId String?
  journalId             String?
  purchaseDocumentId    String?
  salesDocumentId       String?

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdById String?

  organization        Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  importedTransaction ImportedTransaction? @relation(fields: [importedTransactionId], references: [id], onDelete: Cascade)
  journal             Journal?             @relation(fields: [journalId], references: [id], onDelete: Cascade)
  purchaseDocument    PurchaseDocument?    @relation(fields: [purchaseDocumentId], references: [id], onDelete: Cascade)
  salesDocument       SalesDocument?       @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)

  @@index([orgId, importedTransactionId])
  @@index([orgId, journalId])
  @@index([orgId, purchaseDocumentId])
  @@index([orgId, salesDocumentId])
  @@map("ledger_files")
}


model PayrollRun {
  id    String @id @default(cuid())
  orgId String

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  memo        String?

  status     PayrollRunStatus @default(DRAFT)
  journalId  String?          @unique
  postedAt   DateTime?        @db.Timestamptz(6)
  /// When payMode was ACCRUE: journal that pays the payable (Dr payable, Cr bank/cash).
  settlementJournalId String? @unique
  paidAt              DateTime? @db.Timestamptz(6)
  /// Bank / cash (or payable) credited when posting.
  payFromAccountId String?
  /// IMMEDIATE credits the pay account. ACCRUE credits wages payable.
  payMode PayrollPayMode @default(IMMEDIATE)
  /// Draft is waiting for Approve & post. Cleared when the journal is posted or withdrawn.
  awaitingApproval Boolean @default(false)
  /// Credit for deductions and employer costs that have no account of their own.
  liabilityAccountId String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  journal        Journal?      @relation("PayrollRunAccrual", fields: [journalId], references: [id], onDelete: Restrict)
  settlementJournal Journal?   @relation("PayrollRunSettlement", fields: [settlementJournalId], references: [id], onDelete: Restrict)
  payFromAccount LedgerAccount? @relation("PayrollRunPayFrom", fields: [payFromAccountId], references: [id], onDelete: Restrict)
  liabilityAccount LedgerAccount? @relation("PayrollRunLiability", fields: [liabilityAccountId], references: [id], onDelete: Restrict)
  createdBy      User?         @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payslips       Payslip[]

  @@index([orgId, status])
  @@index([orgId, periodStart, periodEnd])
  @@map("payroll_runs")
}

model Payslip {
  id         String @id @default(cuid())
  orgId      String
  runId      String
  employeeId String

  gross       Decimal @db.Decimal(19, 4)
  deductions  Decimal @db.Decimal(19, 4)
  employer    Decimal @default(0) @db.Decimal(19, 4)
  net         Decimal @db.Decimal(19, 4)
  /// PS-00001. Null on runs created before standard payroll.
  number    String?
  /// Excluded slips stay on the draft and are left out of the journal.
  included  Boolean @default(true)
  /// When set, recompute uses these instead of attendance for the period.
  workedDaysOverride       Int?
  workedHoursOverride      Decimal? @db.Decimal(19, 4)
  /// When set, replaces the calculated OT line amount (0 removes OT).
  overtimeAmountOverride   Decimal? @db.Decimal(19, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run          PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines        PayslipLine[]
  recoveries   AdvanceRecovery[]

  @@unique([runId, employeeId])
  @@unique([orgId, number])
  @@index([orgId, employeeId])
  @@map("payslips")
}

model PayslipLine {
  id        String @id @default(cuid())
  orgId     String
  payslipId String

  code   String
  label  String
  amount Decimal         @db.Decimal(19, 4)
  kind   PayslipLineKind
  sortOrder Int @default(0)
  /// Employer cost: shown on the slip, omitted from net pay.
  affectsNet Boolean @default(true)
  expenseAccountId   String?
  liabilityAccountId String?
  /// Set on an ADVANCE line so posting can reduce that balance.
  advanceId String?

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId, sortOrder])
  @@index([orgId])
  @@map("payslip_lines")
}

/// Reusable pay components (basic, housing, transport, employer pension).
model SalaryStructure {

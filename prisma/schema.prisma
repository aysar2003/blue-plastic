enum ReportPackCadence {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
}

/// Phase 26: named bundle of table-report keys, optionally on a schedule.
model ReportPack {
  id    String @id @default(cuid())
  orgId String

  name        String
  description String?

  /// Catalogue keys from `TABLE_REPORTS` / standard report paths (slug after /reports/).
  reportKeys Json

  cadence ReportPackCadence @default(MANUAL)
  /// When cadence is not MANUAL, email this address after each successful run (optional).
  emailTo String?

  /// Next time the cron should build this pack (UTC). Null when MANUAL or paused.
  nextRunAt DateTime? @db.Timestamptz(6)
  lastRunAt DateTime? @db.Timestamptz(6)
  isActive  Boolean   @default(true)

  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  createdById String?

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs         ReportPackRun[]

  @@index([orgId, isActive, nextRunAt])
  @@map("report_packs")
}

model ReportPackRun {
  id     String @id @default(cuid())
  orgId  String
  packId String

  ranAt DateTime @default(now()) @db.Timestamptz(6)
  /// Inclusive calendar range used for every report in the pack.
  fromDate DateTime @db.Date
  toDate   DateTime @db.Date

  status  String  @default("OK")
  message String?
  /// Multi-report Excel body (XLSX1: base64). Legacy CSV runs still download as CSV.
  body    String  @db.Text

  createdById String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pack         ReportPack   @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([orgId, packId, ranAt(sort: Desc)])
  @@map("report_pack_runs")
}

enum CompanyAgreementStatus {
  DRAFT
  ACTIVE
  ENDED
}

/// Contract / rent agreement papers for a company database (system owner desk).
model CompanyAgreement {
  id     String @id @default(cuid())
  orgId  String

  title  String
  status CompanyAgreementStatus @default(DRAFT)
  startsOn DateTime? @db.Date
  endsOn   DateTime? @db.Date
  notes    String?

  originalName String?
  contentType  String?
  byteSize     Int?
  /// Path under uploads/. Never a public URL.
  storageKey   String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@map("company_agreements")
}

/// Public website lead (Pricing / contact form). System owner follows up.
model MarketingLead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  companyName String?
  message     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@map("marketing_leads")
}

/// Platform rent plans (SOM ERP seats / months). System owner configures these.
model PlatformPlan {
  id        String  @id @default(cuid())
  name      String
  months    Int
  price     Decimal @db.Decimal(19, 4)
  currency  String  @default("USD") @db.Char(3)
  /// Seat cap applied on confirm. Null = leave company maxUsers unchanged.
  maxUsers  Int?
  /// Apps granted on confirm. Shape: Record<ModuleFlag, boolean>. Null = leave modules as-is.
  modules   Json?
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  rentPayments CompanyRentPayment[]

  @@index([active, sortOrder])

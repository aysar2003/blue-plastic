/// Pay-to instructions for EVC / Zaad / bank (singleton row id = default).
model PlatformBillingSettings {
  id String @id @default("default")

  evcNumber         String?
  zaadNumber        String?
  edahabNumber      String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  /// Extra text shown on the company billing page.
  instructions      String?

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("platform_billing_settings")
}

enum CompanyRentPaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum RentPaymentMethod {
  EVC
  ZAAD
  EDAHAB
  BANK
}

/// Company submitted proof of platform rent payment — system owner confirms.
model CompanyRentPayment {
  id     String @id @default(cuid())
  orgId  String
  planId String

  status   CompanyRentPaymentStatus @default(PENDING)
  method   RentPaymentMethod
  amount   Decimal                  @db.Decimal(19, 4)
  currency String                   @db.Char(3)
  reference String
  notes     String?

  originalName String?
  contentType  String?
  byteSize     Int?
  /// Path under uploads/rent-payments/. Never a public URL.
  storageKey   String?

  submittedById String
  reviewedAt    DateTime? @db.Timestamptz(6)
  reviewedBy    String?
  reviewNote    String?

  /// Snapshot of the plan at submit time (plan row may change later).
  planName     String
  planMonths   Int
  planMaxUsers Int?
  planModules  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan         PlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)


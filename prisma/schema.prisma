  /// has moved until it becomes an invoice or a sales receipt.
  SALES_ORDER
  SALES_RECEIPT
  CREDIT_MEMO
  CUSTOMER_PAYMENT
  REFUND_RECEIPT
  BILL
  BILL_PAYMENT
  EXPENSE
  VENDOR_CREDIT
  PURCHASE_ORDER
  /// Internal purchase request (PR) — store keeper / warehouse ask; no ledger.
  PURCHASE_REQUEST
  /// Request for quotation from a vendor — prices only; no ledger.
  RFQ
  TRANSFER
  DEPOSIT
  INVENTORY_ADJUSTMENT
  /// Stock moved from one store to another.

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stay          Stay           @relation(fields: [stayId], references: [id], onDelete: Cascade)
  salesDocument SalesDocument? @relation(fields: [salesDocumentId], references: [id], onDelete: SetNull)
  lines         FolioLine[]

  @@index([orgId, status])
  @@map("folios")
}

model FolioLine {
  id          String  @id @default(cuid())
  folioId     String
  itemId      String?
  description String
  quantity    Decimal @db.Decimal(19, 4)
  unitPrice   Decimal @db.Decimal(19, 4)
  amount      Decimal @db.Decimal(19, 4)
  /// Calendar night this room charge covers (nightly post). Null = ad-hoc charge.
  serviceDate DateTime? @db.Date
  postedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)
  item  Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([folioId])
  @@index([folioId, serviceDate])
  @@map("folio_lines")
}

/// Manufacturing: simple routing steps on an assembly / finished good.
/// Manufacturing work center with weekly capacity (software calendar — not MES).
model WorkCenter {
  id                      String  @id @default(cuid())
  orgId                   String
  name                    String
  storeId                 String?
  /// Planned available minutes per week (default 40h = 2400).
  capacityMinutesPerWeek  Decimal @default(2400) @db.Decimal(19, 4)
  /// Optional Mon–Sun minutes (length 7). When set, weekly total should match capacityMinutesPerWeek.
  capacityByWeekday       Json?
  isActive                Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store        Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  routingSteps RoutingStep[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("work_centers")
}

model RoutingStep {
  id           String  @id @default(cuid())
  orgId        String
  itemId       String
  workCenterId String?
  name         String
  sequence     Int     @default(0)
  /// Planned minutes for this operation.
  minutes      Decimal @default(0) @db.Decimal(19, 4)
  notes        String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  workCenter   WorkCenter?  @relation(fields: [workCenterId], references: [id], onDelete: SetNull)

  @@index([orgId, itemId, sequence])
  @@index([workCenterId])
  @@map("routing_steps")
}

/// Distribution: advance ship notice (expected inbound; receive posts PO bill/stock).
enum AsnStatus {
  EXPECTED
  RECEIVED
  CANCELLED
}

model AsnShipment {
  id                 String    @id @default(cuid())
  orgId              String
  vendorId           String
  purchaseDocumentId String?
  number             String
  status             AsnStatus @default(EXPECTED)
  expectedAt         DateTime? @db.Date
  /// Dock / bay label for the appointment.
  dockName           String?
  /// Appointment time (local wall clock stored as timestamptz).
  dockAt             DateTime? @db.Timestamptz(6)
  notes              String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor           Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseDocument PurchaseDocument? @relation(fields: [purchaseDocumentId], references: [id], onDelete: SetNull)
  lines            AsnShipmentLine[]

  @@unique([orgId, number])
  @@index([orgId, status, expectedAt])
  @@index([orgId, dockAt])
  @@index([vendorId])
  @@index([purchaseDocumentId])
  @@map("asn_shipments")
}

model AsnShipmentLine {
  id          String  @id @default(cuid())
  asnId       String
  itemId      String?
  description String
  quantity    Decimal @db.Decimal(19, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  asn  AsnShipment @relation(fields: [asnId], references: [id], onDelete: Cascade)
  item Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([asnId])
  @@index([itemId])
  @@map("asn_shipment_lines")
}

model StockBin {
  id      String @id @default(cuid())
  orgId   String
  storeId String

  code  String
  name  String
  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  picks        PickTask[]
  movements    BinMovement[]
  putaways     PutawayTask[]

  @@unique([storeId, code])
  @@index([orgId, storeId])
  @@map("stock_bins")
}

/// Phase 31: perpetual quantity by bin. Valuation stays on the item stock ledger.
model BinMovement {
  id      String @id @default(cuid())
  orgId   String
  binId   String
  itemId  String

  /// Signed: positive putaway / inbound, negative pick / outbound.
  quantity Decimal @db.Decimal(19, 4)
  /// Running on-hand for this bin+item after the movement.
  runningQuantity Decimal @db.Decimal(19, 4)

  sourceType String
  sourceId   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bin          StockBin     @relation(fields: [binId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orgId, binId, itemId, createdAt])
  @@index([orgId, sourceType, sourceId])
  @@map("bin_movements")
}

enum PutawayTaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// Phase 31: place received stock into a bin (location only; item ledger already has qty).
model PutawayTask {
  id      String @id @default(cuid())
  orgId   String
  storeId String
  binId   String?
  itemId  String

  qty    Decimal           @db.Decimal(19, 4)
  status PutawayTaskStatus @default(OPEN)
  notes  String?

  sourceType String?
  sourceId   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bin          StockBin?    @relation(fields: [binId], references: [id], onDelete: SetNull)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orgId, status, createdAt])
  @@index([orgId, storeId])
  @@map("putaway_tasks")
}

enum PickWaveStatus {
  OPEN
  RELEASED
  DONE
  CANCELLED
}

/// Phase 31: group of pick tasks released together.
model PickWave {
  id    String @id @default(cuid())
  orgId String

  number String
  status PickWaveStatus @default(OPEN)
  notes  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  picks        PickTask[]

  @@unique([orgId, number])
  @@index([orgId, status, createdAt])
  @@map("pick_waves")
}

enum PickTaskStatus {
  OPEN
  PICKING
  PICKED
  CANCELLED
}

model PickTask {
  id      String @id @default(cuid())
  orgId   String
  storeId String
  binId   String?
  itemId  String
  waveId  String?

  qty    Decimal         @db.Decimal(19, 4)
  status PickTaskStatus  @default(OPEN)
  notes  String?

  /// Optional link to a sales order or delivery note (Phase 29).
  sourceType String?
  sourceId   String?

  /// Phase 24 tracking when the item requires it.
  lotNumber    String?
  serialNumber String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bin          StockBin?    @relation(fields: [binId], references: [id], onDelete: SetNull)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  wave         PickWave?    @relation(fields: [waveId], references: [id], onDelete: SetNull)

  @@index([orgId, status, createdAt])
  @@index([orgId, storeId])
  @@index([orgId, sourceType, sourceId])
  @@index([orgId, waveId])
  @@map("pick_tasks")
}

enum DashboardTileKind {
  KPI
  REPORT
  SPARK
}

/// Phase 30: configurable SME board above home KPI pins.
model Dashboard {
  id    String @id @default(cuid())
  orgId String

  name        String
  description String?
  isActive    Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tiles        DashboardTile[]

  @@index([orgId, isActive, name])
  @@map("dashboards")
}

model DashboardTile {
  id          String @id @default(cuid())
  dashboardId String
  orgId       String

  kind      DashboardTileKind
  /// KPI key, report path key, or spark metric id.
  refKey    String
  title     String?
  sortOrder Int     @default(0)
  /// Optional threshold; board shows a banner when the resolved value crosses it.
  threshold Decimal? @db.Decimal(19, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([orgId, dashboardId, sortOrder])
  @@map("dashboard_tiles")
}

/// Phase 32: daily KPI/metric snapshots from business-overview (not a second ledger).
model MetricSnapshot {
  id    String @id @default(cuid())
  orgId String

  /// Calendar day the snapshot represents.
  date    DateTime @db.Date
  metricKey String
  value   Decimal  @db.Decimal(19, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, date, metricKey])
  @@index([orgId, metricKey, date])
  @@map("metric_snapshots")
}

model TrainingCourse {
  id    String @id @default(cuid())
  orgId String

  title       String
  hours       Decimal @default(0) @db.Decimal(19, 4)
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enrollments  TrainingEnrollment[]

  @@index([orgId, active])
  @@map("training_courses")
}

enum TrainingEnrollmentStatus {
  ENROLLED
  COMPLETED
  FAILED
}

model TrainingEnrollment {
  id         String @id @default(cuid())
  orgId      String
  courseId   String
  employeeId String

  status      TrainingEnrollmentStatus @default(ENROLLED)
  completedAt DateTime? @db.Timestamptz(6)
  notes       String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  course       TrainingCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
  @@index([orgId, status])
  @@map("training_enrollments")
}

/// Education: programs / terms / fee plans → student enrollments → AR invoices.
enum EnrollmentStatus {
  ENROLLED
  WITHDRAWN
  COMPLETED
}

model AcademicProgram {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  code     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  feePlans     FeePlan[]
  enrollments  StudentEnrollment[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("academic_programs")
}

model AcademicTerm {
  id       String   @id @default(cuid())
  orgId    String
  name     String
  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date
  isActive Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enrollments  StudentEnrollment[]

  @@unique([orgId, name])
  @@index([orgId, isActive, startsOn])
  @@map("academic_terms")
}

model FeePlan {
  id        String  @id @default(cuid())
  orgId     String
  programId String?
  name      String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  program      AcademicProgram?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  lines        FeePlanLine[]
  enrollments  StudentEnrollment[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@index([programId])
  @@map("fee_plans")
}

model FeePlanLine {
  id          String  @id @default(cuid())
  feePlanId   String
  itemId      String
  description String?
  quantity    Decimal @default(1) @db.Decimal(19, 4)
  /// Null = use the item's sales price at billing time.
  unitPrice   Decimal? @db.Decimal(19, 4)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  feePlan FeePlan @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([feePlanId, sortOrder])
  @@index([itemId])
  @@map("fee_plan_lines")
}

model StudentEnrollment {
  id                  String           @id @default(cuid())
  orgId               String
  customerId          String
  programId           String
  termId              String
  feePlanId           String?
  status              EnrollmentStatus @default(ENROLLED)
  /// Scholarship / grant as percent off the fee invoice (0–100).
  scholarshipPercent  Decimal          @default(0) @db.Decimal(7, 4)
  salesDocumentId     String?          @unique
  notes               String?
  enrolledAt          DateTime         @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  program       AcademicProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  term          AcademicTerm   @relation(fields: [termId], references: [id], onDelete: Restrict)
  feePlan       FeePlan?       @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  salesDocument SalesDocument? @relation(fields: [salesDocumentId], references: [id], onDelete: SetNull)

  @@unique([orgId, customerId, programId, termId])
  @@index([orgId, status, enrolledAt(sort: Desc)])
  @@index([termId, status])
  @@index([customerId])
  @@map("student_enrollments")
}

/// Hospital billing admin only — not a clinical chart / EMR.
enum PatientVisitStatus {
  OPEN
  CLOSED
  CANCELLED
}

model PatientVisit {
  id                  String             @id @default(cuid())
  orgId               String
  customerId          String
  status              PatientVisitStatus @default(OPEN)
  /// Department / class (optional).
  trackingCategoryId  String?
  /// Payer label (self-pay, insurer name) — text only.
  payerName           String?
  /// External claim / policy reference.
  payerRef            String?
  notes               String?
  openedAt            DateTime           @default(now()) @db.Timestamptz(6)
  closedAt            DateTime?          @db.Timestamptz(6)
  salesDocumentId     String?            @unique
  /// Last claims export stamp — skip already-exported visits on the next run unless forced.
  claimsExportedAt    DateTime?          @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  trackingCategory TrackingCategory? @relation(fields: [trackingCategoryId], references: [id], onDelete: SetNull)
  salesDocument    SalesDocument?    @relation(fields: [salesDocumentId], references: [id], onDelete: SetNull)
  charges          VisitCharge[]

  @@index([orgId, status, openedAt(sort: Desc)])
  @@index([orgId, claimsExportedAt])
  @@index([customerId])
  @@index([trackingCategoryId])
  @@map("patient_visits")
}

model VisitCharge {
  id          String  @id @default(cuid())
  visitId     String
  itemId      String?
  description String
  quantity    Decimal @db.Decimal(19, 4)
  unitPrice   Decimal @db.Decimal(19, 4)
  amount      Decimal @db.Decimal(19, 4)
  /// Service / billing code for claims export (not clinical coding).
  billCode    String?
  postedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  visit PatientVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  item  Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([itemId])
  @@map("visit_charges")
}

/// NGO: donor pledge tracked until received as a customer payment.
enum DonorPledgeStatus {
  PLEDGED
  RECEIVED
  CANCELLED
}

model DonorPledge {
  id                 String            @id @default(cuid())
  orgId              String
  customerId         String
  /// Fund / programme class (restriction tag lite).
  trackingCategoryId String?
  amount             Decimal           @db.Decimal(19, 4)
  pledgedAt          DateTime          @db.Date
  dueDate            DateTime?         @db.Date
  status             DonorPledgeStatus @default(PLEDGED)
  purpose            String?
  notes              String?
  paymentId          String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  trackingCategory TrackingCategory? @relation(fields: [trackingCategoryId], references: [id], onDelete: SetNull)
  payment          CustomerPayment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orgId, status, pledgedAt(sort: Desc)])
  @@index([customerId])
  @@index([trackingCategoryId])
  @@index([paymentId])
  @@map("donor_pledges")
}

/// Named retail / trade price list (Pass 1 — more than RETAIL/WHOLESALE).
model PriceList {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items        PriceListItem[]
  customers    Customer[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("price_lists")
}

model PriceListItem {
  id         String  @id @default(cuid())
  priceListId String
  itemId     String
  unitPrice  Decimal @db.Decimal(19, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([priceListId, itemId])
  @@index([itemId])
  @@map("price_list_items")
}

/// Simple % off promotion with a date window (Pass 1 — no loyalty).
model ItemPromotion {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  itemId     String?
  percentOff Decimal  @db.Decimal(7, 4)
  startsOn   DateTime @db.Date
  endsOn     DateTime @db.Date
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item         Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([orgId, isActive, startsOn, endsOn])
  @@index([itemId])
  @@map("item_promotions")
}

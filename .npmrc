# Keep this file OS-neutral — Vercel and CI run Linux.
# On Windows (Cursor), set script-shell in your user npmrc if needed:
#   npm config set script-shell "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
# Do not put that path here; it breaks pnpm install on Linux deploy.

# Avoid parallel native postinstalls OOMing small Vercel builders.
child-concurrency=2
network-concurrency=8
